<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Tên project bắt đầu bằng số ("3DWarehouse") — không phải C# identifier hợp lệ, nên phải
         set RootNamespace/AssemblyName tường minh thay vì để SDK tự suy ra từ tên thư mục. -->
    <RootNamespace>Warehouse3D</RootNamespace>
    <AssemblyName>Warehouse3D</AssemblyName>
    <UserSecretsId>3f2f1b2f-8b7b-4b0e-9a1a-7d6f0b6f2c3e</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Oracle.ManagedDataAccess.Core" Version="3.21.100" />
  </ItemGroup>

</Project>
