@model PmcWh.Web.Models.DemoPagingViewModel
@{
    ViewData["Title"] = "Demo phân trang (data giả)";
}

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body">
        <h5 class="card-title mb-1">Demo phân trang</h5>
        <p class="text-muted small mb-3">97 dòng data giả, 10 dòng/trang — test <code>PaginationHelper</code> + <code>_Pagination.cshtml</code>.</p>

        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr class="text-uppercase text-muted small">
                        <th>Mã hàng</th>
                        <th>Tên hàng</th>
                        <th>Số lượng</th>
                        <th>Ngày nhập</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td class="fw-semibold">@item.MaHang</td>
                            <td>@item.TenHang</td>
                            <td>@item.SoLuong</td>
                            <td>@item.NgayNhap.ToString("dd/MM/yyyy")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="mt-3">
            @await Html.PartialAsync("_Pagination", Model.Pagination)
        </div>
    </div>
</div>
