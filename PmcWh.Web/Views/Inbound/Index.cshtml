@using System.Text.Json
@model PmcWh.Web.Models.InboundViewModel
@{
    ViewData["Title"] = "Quét lên kệ";
    var locationsJson = JsonSerializer.Serialize(Model.Locations, new JsonSerializerOptions(JsonSerializerDefaults.Web));
}

<div class="card border-0 shadow-sm rounded-4 mb-3">
    <div class="card-body">
        <div class="d-flex align-items-center gap-3 mb-4">
            <span class="d-inline-flex align-items-center justify-content-center rounded-4"
                  style="width:48px;height:48px;background:linear-gradient(135deg, #495057 0%, #212529 100%); flex-shrink:0;">
                <span class="material-icons text-white">qr_code_scanner</span>
            </span>
            <div>
                <h5 class="card-title mb-0">Quét lên kệ</h5>
                <p class="text-muted small mb-0">Lên kệ liệu mới từ khu vực chờ, hoặc nhận lại hàng đã xuất về kệ</p>
            </div>
        </div>

        <label class="form-label small fw-semibold text-secondary">Quét barcode</label>
        <div class="input-group" style="max-width: 420px;">
            <span class="input-group-text bg-white"><span class="material-icons" style="font-size:18px;">qr_code_scanner</span></span>
            <input type="text" id="scanInput" class="form-control" placeholder="Quét hoặc gõ barcode rồi Enter..." autofocus autocomplete="off" />
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body">
        <div class="d-flex flex-wrap align-items-center gap-2 mb-4">
            <h5 class="card-title mb-0 me-1">Cần lên kệ</h5>

            <span class="d-inline-flex align-items-center gap-1 rounded-pill px-3 py-1 small fw-semibold"
                  style="background-color:rgba(33,37,41,0.06);color:#212529;">
                <span class="material-icons" style="font-size:16px;">inventory_2</span>
                Tổng @(Model.StagingItems.Count + Model.ReturnableItems.Count)
            </span>

            <span class="d-inline-flex align-items-center gap-1 rounded-pill px-3 py-1 small fw-semibold"
                  style="background-color:rgba(13,110,253,0.12);color:#0d6efd;">
                <span class="material-icons" style="font-size:16px;">new_releases</span>
                Mới nhập @Model.StagingItems.Count
            </span>

            <span class="d-inline-flex align-items-center gap-1 rounded-pill px-3 py-1 small fw-semibold"
                  style="background-color:rgba(255,193,7,0.15);color:#997404;">
                <span class="material-icons" style="font-size:16px;">assignment_return</span>
                Nhận lại @Model.ReturnableItems.Count
            </span>
        </div>

        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr class="text-uppercase text-muted small">
                        <th>Barcode</th>
                        <th>Dev</th>
                        <th>Model</th>
                        <th>Colorway</th>
                        <th>Size</th>
                        <th>Loại</th>
                        <th class="text-end">Số lượng</th>
                        <th>Kệ hiện tại</th>
                        <th class="text-end">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in Model.StagingItems)
                    {
                        <tr class="js-shelf-row js-detail-row" data-material-id="@m.MaterialId" data-barcode="@m.Barcode" title="Double-click để xem chi tiết">
                            <td class="fw-semibold">@m.Barcode</td>
                            <td>@m.Dev</td>
                            <td>@m.Model</td>
                            <td>@m.Colorway</td>
                            <td>@m.SizeSpec</td>
                            <td><span class="badge" style="background-color:rgba(13,110,253,0.12);color:#0d6efd;">Mới nhập</span></td>
                            <td class="text-end">@m.ArrivalQty @m.Unit</td>
                            <td>@(m.LocationCode ?? "—")</td>
                            <td class="text-end">
                                <button type="button" class="btn btn-sm pmc-btn-dark js-open-shelf"
                                        data-material-id="@m.MaterialId" data-barcode="@m.Barcode" data-kind="new">
                                    Lên kệ
                                </button>
                            </td>
                        </tr>
                    }
                    @foreach (var m in Model.ReturnableItems)
                    {
                        var outstanding = (m.ArrivalQty ?? 0) - (m.Balance ?? 0);
                        <tr class="js-shelf-row js-detail-row" data-material-id="@m.MaterialId" data-barcode="@m.Barcode" title="Double-click để xem chi tiết">
                            <td class="fw-semibold">@m.Barcode</td>
                            <td>@m.Dev</td>
                            <td>@m.Model</td>
                            <td>@m.Colorway</td>
                            <td>@m.SizeSpec</td>
                            <td><span class="badge" style="background-color:rgba(255,193,7,0.15);color:#997404;">Nhận lại</span></td>
                            <td class="text-end">@outstanding @m.Unit</td>
                            <td>@(m.LocationCode ?? "—")</td>
                            <td class="text-end">
                                <button type="button" class="btn btn-sm pmc-btn-dark js-open-shelf"
                                        data-material-id="@m.MaterialId" data-barcode="@m.Barcode" data-kind="return"
                                        data-outstanding="@outstanding" data-unit="@m.Unit" data-location-code="@m.LocationCode">
                                    Nhận lại
                                </button>
                            </td>
                        </tr>
                    }
                    @if (Model.StagingItems.Count == 0 && Model.ReturnableItems.Count == 0)
                    {
                        <tr>
                            <td colspan="9" class="text-center text-muted py-4">Không có liệu nào cần lên kệ.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="shelfModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 shadow">
            <div class="modal-header border-0">
                <h5 class="modal-title"><span id="shelfModalTitle">Lên kệ</span> — <span id="shelfBarcodeLabel"></span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="Inbound" asp-action="Scan" method="post">
                <input type="hidden" name="materialId" id="shelfMaterialId" />
                <input type="hidden" name="barcode" id="shelfBarcode" />
                <div class="modal-body">
                    <div id="qtyGroup" class="d-none">
                        <p class="text-muted small mb-2">Đã xuất còn thiếu: <span id="outstandingLabel" class="fw-semibold"></span></p>
                        <label class="form-label small fw-semibold text-secondary">Số lượng nhận lại</label>
                        <input type="number" name="qty" id="qtyInput" class="form-control mb-3" step="0.01" min="0.01" disabled />
                    </div>

                    <div id="keepShelfInfo" class="d-none alert alert-secondary py-2 px-3 small mb-0">
                        Liệu chưa từng rời kệ — giữ nguyên vị trí <span id="keepShelfCode" class="fw-semibold"></span>.
                    </div>

                    <div id="shelfPickGroup">
                        <label class="form-label small fw-semibold text-secondary">Kệ</label>
                        <select id="rackSelect" class="form-select mb-3"></select>

                        <label class="form-label small fw-semibold text-secondary">Tầng</label>
                        <select name="locationId" id="levelSelect" class="form-select" required></select>
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn pmc-btn-dark d-inline-flex align-items-center gap-1">
                        <span class="material-icons" style="font-size:18px;">check</span> Xác nhận
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<div id="pmc-flash"
     data-success="@(ViewData["FlashSuccess"] as string)"
     data-error="@(ViewData["FlashError"] as string)"
     style="display:none"></div>

@section Scripts {
    <script>
        (function () {
            var flash = document.getElementById('pmc-flash');
            if (flash.dataset.success) PmcUI.success(flash.dataset.success);
            if (flash.dataset.error) PmcUI.error(flash.dataset.error);

            var locations = @Html.Raw(locationsJson);
            var byRack = {};
            locations.forEach(function (loc) {
                (byRack[loc.rackNo] = byRack[loc.rackNo] || []).push(loc);
            });
            var racks = Object.keys(byRack).map(Number).sort(function (a, b) { return a - b; });

            var rackSelect = document.getElementById('rackSelect');
            var levelSelect = document.getElementById('levelSelect');

            racks.forEach(function (rack) {
                var opt = document.createElement('option');
                opt.value = rack;
                opt.textContent = 'Kệ ' + rack;
                rackSelect.appendChild(opt);
            });

            function populateLevels(rack) {
                levelSelect.innerHTML = '';
                (byRack[rack] || []).sort(function (a, b) { return a.levelNo - b.levelNo; }).forEach(function (loc) {
                    var opt = document.createElement('option');
                    opt.value = loc.locationId;
                    opt.textContent = 'Tầng ' + loc.levelNo + ' (' + loc.code + ')';
                    levelSelect.appendChild(opt);
                });
            }

            rackSelect.addEventListener('change', function () { populateLevels(rackSelect.value); });
            if (racks.length > 0) {
                rackSelect.value = racks[0];
                populateLevels(racks[0]);
            }

            var shelfModal = new bootstrap.Modal(document.getElementById('shelfModal'));
            var qtyGroup = document.getElementById('qtyGroup');
            var qtyInput = document.getElementById('qtyInput');
            var outstandingLabel = document.getElementById('outstandingLabel');
            var keepShelfInfo = document.getElementById('keepShelfInfo');
            var keepShelfCode = document.getElementById('keepShelfCode');
            var shelfPickGroup = document.getElementById('shelfPickGroup');

            function openShelfFor(materialId, barcode, kind, outstanding, unit, locationCode) {
                document.getElementById('shelfMaterialId').value = materialId;
                document.getElementById('shelfBarcode').value = barcode;
                document.getElementById('shelfBarcodeLabel').textContent = barcode;
                document.getElementById('shelfModalTitle').textContent = kind === 'return' ? 'Nhận lại' : 'Lên kệ';

                if (kind === 'return') {
                    qtyGroup.classList.remove('d-none');
                    qtyInput.disabled = false;
                    qtyInput.required = true;
                    qtyInput.value = outstanding;
                    qtyInput.max = outstanding;
                    outstandingLabel.textContent = outstanding + ' ' + (unit || '');
                } else {
                    qtyGroup.classList.add('d-none');
                    qtyInput.disabled = true;
                    qtyInput.required = false;
                    qtyInput.value = '';
                }

                // Nhận lại 1 phần: liệu chưa rời kệ (đã có locationCode) — giữ nguyên, không cho chọn kệ mới.
                if (kind === 'return' && locationCode) {
                    keepShelfInfo.classList.remove('d-none');
                    keepShelfCode.textContent = locationCode;
                    shelfPickGroup.classList.add('d-none');
                    levelSelect.disabled = true;
                    levelSelect.required = false;
                } else {
                    keepShelfInfo.classList.add('d-none');
                    shelfPickGroup.classList.remove('d-none');
                    levelSelect.disabled = false;
                    levelSelect.required = true;
                }

                shelfModal.show();
            }

            document.querySelectorAll('.js-open-shelf').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    openShelfFor(btn.dataset.materialId, btn.dataset.barcode, btn.dataset.kind, btn.dataset.outstanding, btn.dataset.unit, btn.dataset.locationCode);
                });
            });

            var shelfForm = document.querySelector('#shelfModal form');
            shelfForm.addEventListener('submit', function () {
                shelfForm.querySelector('button[type="submit"]').disabled = true;
            });

            var scanInput = document.getElementById('scanInput');
            scanInput.addEventListener('keydown', function (e) {
                if (e.key !== 'Enter') return;
                e.preventDefault();
                var code = scanInput.value.trim();
                scanInput.value = '';
                if (!code) return;

                var row = document.querySelector('.js-shelf-row[data-barcode="' + CSS.escape(code) + '"]');
                if (!row) {
                    PmcUI.error('Không tìm thấy barcode "' + code + '" trong danh sách cần lên kệ.');
                    return;
                }
                var btn = row.querySelector('.js-open-shelf');
                openShelfFor(btn.dataset.materialId, btn.dataset.barcode, btn.dataset.kind, btn.dataset.outstanding, btn.dataset.unit, btn.dataset.locationCode);
            });
        })();
    </script>
}
