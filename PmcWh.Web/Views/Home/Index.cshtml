@model PmcWh.Web.Models.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="row g-4">
    @foreach (var card in Model.Cards)
    {
        <div class="col-md-3">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-muted mb-1">@card.Title</h6>
                        <h3 class="mb-0">@card.Value</h3>
                    </div>
                    <div class="rounded-circle bg-@card.Color text-white d-flex align-items-center justify-content-center" style="width:48px;height:48px;">
                        <span class="material-icons">@card.Icon</span>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<div class="card mt-4 shadow-sm border-0 rounded-4">
    <div class="card-body">
        <h5 class="card-title">System overview</h5>
        <p class="text-muted mb-0">This dashboard is ready for Material-style expansion and API integration.</p>
    </div>
</div>
