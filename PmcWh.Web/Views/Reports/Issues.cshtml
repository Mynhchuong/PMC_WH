@using PmcWh.Web.Helpers
@model PmcWh.Web.Models.IssueReportListViewModel
@{
    ViewData["Title"] = "Báo cáo xuất kho";
    ViewData["TitleKey"] = "menuReportsIssues";
    var hasAnyFilter = Model.FromDate.HasValue || Model.ToDate.HasValue || Model.RecipientId.HasValue || Model.OverdueOnly;
}

<div class="card border-0 shadow-sm rounded-4 mb-2">
    <div class="card-body py-2">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-2">
            <div class="d-flex align-items-center gap-2">
                <span class="d-inline-flex align-items-center justify-content-center rounded-3"
                      style="width:34px;height:34px;background:linear-gradient(135deg, #495057 0%, #212529 100%); flex-shrink:0;">
                    <span class="material-icons text-white" style="font-size:18px;">summarize</span>
                </span>
                <div>
                    <h6 class="card-title mb-0" data-i18n="menuReportsIssues">Báo cáo xuất kho</h6>
                    <p class="text-muted mb-0" style="font-size:0.7rem;" data-i18n="reportsSubtitle">Ai đã nhận, xuất lúc nào, mã nào — kèm cảnh báo quá 90 ngày</p>
                </div>
            </div>
            <a asp-controller="Reports" asp-action="ExportIssuesExcel"
               asp-route-fromDate="@Model.FromDate?.ToString("yyyy-MM-dd")"
               asp-route-toDate="@Model.ToDate?.ToString("yyyy-MM-dd")"
               asp-route-recipientId="@Model.RecipientId"
               asp-route-overdueOnly="@Model.OverdueOnly"
               class="btn btn-sm pmc-btn-dark d-inline-flex align-items-center gap-1">
                <span class="material-icons" style="font-size:15px;">file_download</span> <span data-i18n="btnExportExcel">Xuất Excel</span>
            </a>
        </div>

        <form asp-controller="Reports" asp-action="Issues" method="get" class="d-flex flex-wrap align-items-end gap-2">
            <div style="width:135px;">
                <label class="form-label small fw-semibold text-secondary mb-1" data-i18n="fromDateLabel">Từ ngày</label>
                <input type="date" name="fromDate" value="@Model.FromDate?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
            </div>
            <div style="width:135px;">
                <label class="form-label small fw-semibold text-secondary mb-1" data-i18n="filterToDate">Đến ngày</label>
                <input type="date" name="toDate" value="@Model.ToDate?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
            </div>
            <div style="width:180px;">
                <label class="form-label small fw-semibold text-secondary mb-1" data-i18n="issuedForLabel">Xuất cho</label>
                <select name="recipientId" class="form-select form-select-sm">
                    <option value="" data-i18n="filterStatusAll">Tất cả</option>
                    @foreach (var r in Model.Recipients)
                    {
                        <option value="@r.RecipientId" selected="@(Model.RecipientId == r.RecipientId)">@r.Name</option>
                    }
                </select>
            </div>
            <div class="form-check mb-1">
                <input type="checkbox" name="overdueOnly" value="true" class="form-check-input" id="overdueOnlyCheck" checked="@Model.OverdueOnly" />
                <label class="form-check-label small" for="overdueOnlyCheck" data-i18n="overdueOnlyLabel">Chỉ quá 90 ngày</label>
            </div>
            <div class="d-flex gap-1">
                <button type="submit" class="btn btn-sm btn-outline-dark d-inline-flex align-items-center justify-content-center gap-1">
                    <span class="material-icons" style="font-size:15px;">filter_alt</span> <span data-i18n="btnFilter">Lọc</span>
                </button>
                @if (hasAnyFilter)
                {
                    <a asp-controller="Reports" asp-action="Issues" class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center justify-content-center gap-1">
                        <span class="material-icons" style="font-size:15px;">filter_alt_off</span> <span data-i18n="btnClearFilter">Bỏ lọc</span>
                    </a>
                }
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr class="text-uppercase text-muted small">
                        <th>Barcode</th>
                        <th>Dev / Model</th>
                        <th>Size</th>
                        <th class="text-end" data-i18n="colQtyIssued">SL xuất</th>
                        <th data-i18n="issuedForLabel">Xuất cho</th>
                        <th data-i18n="colIssuedBy">Người xuất</th>
                        <th data-i18n="colIssuedTime">Thời gian xuất</th>
                        <th data-i18n="colStatus">Trạng thái</th>
                        <th class="text-end" data-i18n="colDaysIssued">Số ngày đã xuất</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var i in Model.Items)
                    {
                        <tr class="js-detail-row" data-material-id="@i.MaterialId" data-barcode="@i.Barcode" title="Double-click để xem chi tiết">
                            <td class="fw-semibold">@i.Barcode</td>
                            <td>@i.Dev @(!string.IsNullOrEmpty(i.Dev) && !string.IsNullOrEmpty(i.Model) ? "/" : "") @i.Model</td>
                            <td>@i.SizeSpec</td>
                            <td class="text-end">@i.Qty @i.Unit</td>
                            <td>@(i.RecipientName ?? "—")</td>
                            <td>@(i.Username ?? "—")</td>
                            <td class="text-muted small">@i.OccurredAt.ToString("dd/MM/yyyy HH:mm")</td>
                            <td data-i18n="@("status" + i.Status)">@MaterialStatusHelper.Label(i.Status)</td>
                            <td class="text-end">
                                @if (i.DaysOut.HasValue)
                                {
                                    <span class="badge @(i.DaysOut > 90 ? "bg-danger" : "bg-secondary")">@i.DaysOut<span data-i18n="daysWord"> ngày</span></span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                        </tr>
                    }
                    @if (Model.Items.Count == 0)
                    {
                        <tr>
                            <td colspan="9" class="text-center text-muted py-4" data-i18n="emptyMaterials">Không có dữ liệu phù hợp.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="mt-3">
            @await Html.PartialAsync("_Pagination", Model.Pagination)
        </div>
    </div>
</div>
