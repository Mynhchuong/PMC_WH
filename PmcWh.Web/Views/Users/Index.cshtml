@model PmcWh.Web.Models.UserListViewModel
@{
    ViewData["Title"] = "Người dùng";
}

<div class="card border-0 shadow-sm rounded-4 mb-3">
    <div class="card-body">
        <h5 class="card-title mb-3">Thêm người dùng</h5>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger" role="alert">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <div>@error.ErrorMessage</div>
                }
            </div>
        }

        <form asp-controller="Users" asp-action="Create" method="post" class="row g-2 align-items-end">
            <input type="hidden" name="page" value="@Model.Pagination.Page" />
            <input type="hidden" name="pageSize" value="@Model.Pagination.PageSize" />

            <div class="col-sm-6 col-md-2">
                <label asp-for="NewUser.Username" class="form-label small fw-semibold text-secondary"></label>
                <input asp-for="NewUser.Username" class="form-control" />
            </div>
            <div class="col-sm-6 col-md-2">
                <label asp-for="NewUser.Password" class="form-label small fw-semibold text-secondary"></label>
                <input asp-for="NewUser.Password" type="password" class="form-control" />
            </div>
            <div class="col-sm-6 col-md-3">
                <label asp-for="NewUser.FullName" class="form-label small fw-semibold text-secondary"></label>
                <input asp-for="NewUser.FullName" class="form-control" />
            </div>
            <div class="col-sm-6 col-md-2">
                <label asp-for="NewUser.Role" class="form-label small fw-semibold text-secondary"></label>
                <select asp-for="NewUser.Role" class="form-select">
                    <option value="Member">Member</option>
                    <option value="Admin">Admin</option>
                </select>
            </div>
            <div class="col-sm-6 col-md-2">
                <button type="submit" class="btn btn-primary w-100">Tạo</button>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body">
        <h5 class="card-title mb-3">Danh sách người dùng</h5>

        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr class="text-uppercase text-muted small">
                        <th>Username</th>
                        <th>Họ tên</th>
                        <th>Vai trò</th>
                        <th>Trạng thái</th>
                        <th>Ngày tạo</th>
                        <th class="text-end">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in Model.Items)
                    {
                        <tr>
                            <td class="fw-semibold">@u.Username</td>
                            <td>@u.FullName</td>
                            <td>@u.Role</td>
                            <td>
                                @if (u.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactive</span>
                                }
                            </td>
                            <td>@u.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="text-end">
                                <form asp-controller="Users" asp-action="ResetPassword" method="post" class="d-inline js-reset-password-form">
                                    <input type="hidden" name="userId" value="@u.UserId" />
                                    <input type="hidden" name="username" value="@u.Username" />
                                    <input type="hidden" name="page" value="@Model.Pagination.Page" />
                                    <input type="hidden" name="pageSize" value="@Model.Pagination.PageSize" />
                                    <button type="submit" class="btn btn-sm btn-outline-warning">Reset mật khẩu</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="mt-3">
            @await Html.PartialAsync("_Pagination", Model.Pagination)
        </div>
    </div>
</div>

<div id="pmc-flash" data-success="@(ViewData["FlashSuccess"] as string)" data-error="@(ViewData["FlashError"] as string)" style="display:none"></div>
<script>
    (function () {
        var flash = document.getElementById('pmc-flash');
        if (flash.dataset.success) PmcUI.success(flash.dataset.success);
        if (flash.dataset.error) PmcUI.error(flash.dataset.error);

        document.querySelectorAll('.js-reset-password-form').forEach(function (form) {
            form.addEventListener('submit', async function (e) {
                e.preventDefault();
                var username = form.querySelector('input[name="username"]').value;
                var ok = await PmcUI.confirm('Đặt lại mật khẩu của "' + username + '" về 123456?', { title: 'Reset mật khẩu', variant: 'warning' });
                if (ok) form.submit();
            });
        });
    })();
</script>
