@model PmcWh.Web.Models.UserListViewModel
@{
    ViewData["Title"] = "Người dùng";
    ViewData["TitleKey"] = "menuUsers";

    (string cls, string style) RoleBadge(string role) => role == "Admin"
        ? ("bg-dark text-white", "")
        : ("text-info", "background-color:rgba(13,202,240,0.15);");

    string InitialOf(string username) => username.Length > 0 ? username[..1].ToUpperInvariant() : "?";
}

<div class="card border-0 shadow-sm rounded-4 mb-3">
    <div class="card-body">
        <div class="d-flex align-items-center gap-3 mb-4">
            <span class="d-inline-flex align-items-center justify-content-center rounded-4"
                  style="width:48px;height:48px;background:linear-gradient(135deg, #6610f2 0%, #4909ad 100%); flex-shrink:0;">
                <span class="material-icons text-white">person_add</span>
            </span>
            <div>
                <h5 class="card-title mb-0" data-i18n="addUserTitle">Thêm người dùng</h5>
                <p class="text-muted small mb-0" data-i18n="addUserSubtitle">Tạo tài khoản đăng nhập cho nhân viên kho</p>
            </div>
        </div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger d-flex align-items-center gap-2" role="alert">
                <span class="material-icons">error_outline</span>
                <div>
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <div>@error.ErrorMessage</div>
                    }
                </div>
            </div>
        }

        <form asp-controller="Users" asp-action="Create" method="post" class="row g-3 align-items-end">
            <input type="hidden" name="page" value="@Model.Pagination.Page" />
            <input type="hidden" name="pageSize" value="@Model.Pagination.PageSize" />

            <div class="col-sm-6 col-md-2">
                <label asp-for="NewUser.Username" class="form-label small fw-semibold text-secondary" data-i18n="loginUsername"></label>
                <div class="input-group">
                    <span class="input-group-text bg-white"><span class="material-icons" style="font-size:18px;">person</span></span>
                    <input asp-for="NewUser.Username" class="form-control" placeholder="worker1" />
                </div>
            </div>
            <div class="col-sm-6 col-md-2">
                <label asp-for="NewUser.Password" class="form-label small fw-semibold text-secondary" data-i18n="loginPassword"></label>
                <div class="input-group">
                    <span class="input-group-text bg-white"><span class="material-icons" style="font-size:18px;">lock</span></span>
                    <input asp-for="NewUser.Password" type="password" class="form-control" placeholder="••••••" />
                </div>
            </div>
            <div class="col-sm-6 col-md-3">
                <label asp-for="NewUser.FullName" class="form-label small fw-semibold text-secondary" data-i18n="fullNameLabel"></label>
                <div class="input-group">
                    <span class="input-group-text bg-white"><span class="material-icons" style="font-size:18px;">badge</span></span>
                    <input asp-for="NewUser.FullName" class="form-control" placeholder="Nguyễn Văn A" />
                </div>
            </div>
            <div class="col-sm-6 col-md-2">
                <label asp-for="NewUser.Role" class="form-label small fw-semibold text-secondary" data-i18n="roleLabel"></label>
                <select asp-for="NewUser.Role" class="form-select">
                    <option value="Member">Member</option>
                    <option value="Admin">Admin</option>
                </select>
            </div>
            <div class="col-sm-6 col-md-2">
                <button type="submit" class="btn pmc-btn-dark w-100 d-inline-flex align-items-center justify-content-center gap-1">
                    <span class="material-icons" style="font-size:18px;">add</span> <span data-i18n="btnCreate">Tạo</span>
                </button>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body">
        <h5 class="card-title mb-3" data-i18n="userListTitle">Danh sách người dùng</h5>

        <div class="table-responsive pmc-table-scroll">
            <table class="table align-middle">
                <thead>
                    <tr class="text-uppercase text-muted small">
                        <th data-i18n="colUser">Người dùng</th>
                        <th data-i18n="roleLabel">Vai trò</th>
                        <th data-i18n="colStatus">Trạng thái</th>
                        <th data-i18n="detailCreatedAt">Ngày tạo</th>
                        <th class="text-end" data-i18n="colAction">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in Model.Items)
                    {
                        var (badgeCls, badgeStyle) = RoleBadge(u.Role);
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="d-inline-flex align-items-center justify-content-center rounded-circle bg-light fw-bold text-secondary" style="width:36px;height:36px;flex-shrink:0;">
                                        @InitialOf(u.Username)
                                    </span>
                                    <div>
                                        <div class="fw-semibold">@u.Username</div>
                                        <div class="text-muted small">@u.FullName</div>
                                    </div>
                                </div>
                            </td>
                            <td><span class="badge @badgeCls" style="@badgeStyle">@u.Role</span></td>
                            <td>
                                @if (u.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactive</span>
                                }
                            </td>
                            <td class="text-muted small">@u.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="text-end">
                                <button type="button" class="btn btn-sm btn-outline-secondary js-change-password-btn"
                                        data-id="@u.UserId" data-username="@u.Username" title="Đổi mật khẩu" data-i18n-title="btnChangePassword">
                                    <span class="material-icons" style="font-size:16px;">password</span>
                                </button>
                                <form asp-controller="Users" asp-action="ResetPassword" method="post" class="d-inline js-reset-password-form">
                                    <input type="hidden" name="userId" value="@u.UserId" />
                                    <input type="hidden" name="username" value="@u.Username" />
                                    <input type="hidden" name="page" value="@Model.Pagination.Page" />
                                    <input type="hidden" name="pageSize" value="@Model.Pagination.PageSize" />
                                    <button type="submit" class="btn btn-sm btn-outline-warning d-inline-flex align-items-center gap-1">
                                        <span class="material-icons" style="font-size:16px;">restart_alt</span> <span data-i18n="btnResetPassword">Reset mật khẩu</span>
                                    </button>
                                </form>
                                <form asp-controller="Users" asp-action="ToggleActive" method="post" class="d-inline js-toggle-user-form">
                                    <input type="hidden" name="userId" value="@u.UserId" />
                                    <input type="hidden" name="username" value="@u.Username" />
                                    <input type="hidden" name="page" value="@Model.Pagination.Page" />
                                    <input type="hidden" name="pageSize" value="@Model.Pagination.PageSize" />
                                    <button type="submit" class="btn btn-sm @(u.IsActive ? "btn-outline-secondary" : "btn-outline-success")" data-i18n="@(u.IsActive ? "btnDisable" : "btnEnable")">
                                        @(u.IsActive ? "Tắt" : "Bật lại")
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="mt-3">
            @await Html.PartialAsync("_Pagination", Model.Pagination)
        </div>
    </div>
</div>

<div class="modal fade" id="changePasswordModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 shadow">
            <div class="modal-header border-0">
                <h5 class="modal-title" data-i18n="changePasswordModalTitle">Đổi mật khẩu</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="Users" asp-action="ChangePassword" method="post">
                <input type="hidden" name="userId" id="chgPwd_UserId" />
                <input type="hidden" name="username" id="chgPwd_Username" />
                <input type="hidden" name="page" value="@Model.Pagination.Page" />
                <input type="hidden" name="pageSize" value="@Model.Pagination.PageSize" />
                <div class="modal-body">
                    <p class="text-muted small mb-2" id="chgPwd_ForLabel"></p>
                    <label class="form-label small fw-semibold text-secondary mb-1" data-i18n="newPasswordLabel">Mật khẩu mới</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white"><span class="material-icons" style="font-size:18px;">lock</span></span>
                        <input type="password" name="newPassword" class="form-control" minlength="6" required placeholder="••••••" />
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal" data-i18n="btnCancel">Hủy</button>
                    <button type="submit" class="btn pmc-btn-dark" data-i18n="btnSave">Lưu</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div id="pmc-flash" data-success="@(ViewData["FlashSuccess"] as string)" data-error="@(ViewData["FlashError"] as string)" style="display:none"></div>

@section Scripts {
    <script>
        (function () {
            var flash = document.getElementById('pmc-flash');
            if (flash.dataset.success) PmcUI.success(PmcWhI18n.renderFlash(flash.dataset.success));
            if (flash.dataset.error) PmcUI.error(PmcWhI18n.renderFlash(flash.dataset.error));

            document.querySelectorAll('.js-reset-password-form').forEach(function (form) {
                form.addEventListener('submit', async function (e) {
                    e.preventDefault();
                    var username = form.querySelector('input[name="username"]').value;
                    var ok = await PmcUI.confirm(PmcWhI18n.t('confirmResetPasswordMsg').replace('{username}', username), { title: PmcWhI18n.t('btnResetPassword'), variant: 'warning' });
                    if (ok) form.submit();
                });
            });

            document.querySelectorAll('.js-toggle-user-form').forEach(function (form) {
                form.addEventListener('submit', async function (e) {
                    e.preventDefault();
                    var username = form.querySelector('input[name="username"]').value;
                    var ok = await PmcUI.confirm(PmcWhI18n.t('confirmToggleUserMsg').replace('{0}', username), { title: PmcWhI18n.t('btnDisable'), variant: 'warning' });
                    if (ok) form.submit();
                });
            });

            var changePasswordModalEl = document.getElementById('changePasswordModal');
            if (changePasswordModalEl) {
                var changePasswordModal = new bootstrap.Modal(changePasswordModalEl);
                document.querySelectorAll('.js-change-password-btn').forEach(function (btn) {
                    btn.addEventListener('click', function () {
                        document.getElementById('chgPwd_UserId').value = btn.dataset.id;
                        document.getElementById('chgPwd_Username').value = btn.dataset.username;
                        document.getElementById('chgPwd_ForLabel').textContent = btn.dataset.username;
                        changePasswordModalEl.querySelector('input[name="newPassword"]').value = '';
                        changePasswordModal.show();
                    });
                });
            }
        })();
    </script>
}
