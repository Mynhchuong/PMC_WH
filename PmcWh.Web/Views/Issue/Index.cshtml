@using System.Text.Json
@model PmcWh.Web.Models.IssueViewModel
@{
    ViewData["Title"] = "Xuất hàng";
    ViewData["TitleKey"] = "menuIssue";
    var itemsJson = JsonSerializer.Serialize(
        Model.IssuableItems.Select(m => new { m.MaterialId, m.Barcode, m.Balance, m.Unit }),
        new JsonSerializerOptions(JsonSerializerDefaults.Web));
}

<div class="card border-0 shadow-sm rounded-4 mb-2">
    <div class="card-body py-2">
        <div class="d-flex align-items-center gap-2 mb-2">
            <span class="d-inline-flex align-items-center justify-content-center rounded-3"
                  style="width:34px;height:34px;background:linear-gradient(135deg, #fd7e14 0%, #c2570a 100%); flex-shrink:0;">
                <span class="material-icons text-white" style="font-size:18px;">local_shipping</span>
            </span>
            <div>
                <h6 class="card-title mb-0" data-i18n="menuIssue">Xuất hàng</h6>
                <p class="text-muted mb-0" style="font-size:0.7rem;" data-i18n="issueSubtitle">Xuất liệu cho DEV/Workshop, trừ tồn kho</p>
            </div>
        </div>

        <label class="form-label small fw-semibold text-secondary mb-1" data-i18n="scanBarcodeLabel">Quét barcode</label>
        <div class="input-group input-group-sm mb-2" style="max-width: 420px;">
            <span class="input-group-text bg-white"><span class="material-icons" style="font-size:16px;">qr_code_scanner</span></span>
            <input type="text" id="scanInput" class="form-control" placeholder="Quét hoặc gõ barcode rồi Enter..." data-i18n-placeholder="scanBarcodePlaceholder" autofocus autocomplete="off" />
        </div>

        <form asp-controller="Issue" asp-action="Index" method="get" class="d-flex flex-wrap align-items-end gap-2">
            @await Html.PartialAsync("_SearchConditions", (PmcWh.Web.Models.SearchFilterFields)Model)
            <div class="d-flex gap-1">
                <button type="submit" class="btn btn-sm btn-outline-dark d-inline-flex align-items-center gap-1">
                    <span class="material-icons" style="font-size:15px;">filter_alt</span> <span data-i18n="btnFilter">Lọc</span>
                </button>
                @if (Model.HasAnySearch)
                {
                    <a asp-controller="Issue" asp-action="Index" class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1">
                        <span class="material-icons" style="font-size:15px;">filter_alt_off</span> <span data-i18n="btnClearFilter">Bỏ lọc</span>
                    </a>
                }
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body">
        <h5 class="card-title mb-3"><span data-i18n="issuableTitle">Có thể xuất</span> (@Model.IssuableItems.Count)</h5>

        <div class="table-responsive pmc-table-scroll">
            <table id="materialsTable" class="table align-middle table-sm pmc-table-compact" style="table-layout: fixed;">
                <colgroup>
                    @{ await Html.RenderPartialAsync("_MaterialColGroup"); }
                    <col style="width: 100px">
                    <col style="width: 110px">
                    <col style="width: 110px">
                </colgroup>
                <thead>
                    <tr class="text-uppercase text-muted small" style="white-space: normal;">
                        @{ await Html.RenderPartialAsync("_MaterialColHeaders"); }
                        <th class="text-end" data-i18n="colBalance">Tồn</th>
                        <th data-i18n="colCurrentShelf">Kệ hiện tại</th>
                        <th class="text-end" data-i18n="colAction">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in Model.IssuableItems)
                    {
                        <tr class="js-issuable-row js-detail-row" data-material-id="@m.MaterialId" data-barcode="@m.Barcode" title="Double-click để xem chi tiết">
                            @{ await Html.RenderPartialAsync("_MaterialColCells", m); }
                            <td class="text-end">@m.Balance @m.Unit</td>
                            <td>@(m.LocationCode ?? "—")</td>
                            <td class="text-end">
                                <button type="button" class="btn btn-sm pmc-btn-dark js-open-issue"
                                        data-material-id="@m.MaterialId" data-barcode="@m.Barcode">
                                    <span data-i18n="btnIssueAction">Xuất</span>
                                </button>
                            </td>
                        </tr>
                    }
                    @if (Model.IssuableItems.Count == 0)
                    {
                        <tr>
                            <td colspan="21" class="text-center text-muted py-4" data-i18n="emptyIssuable">Không có liệu nào có thể xuất.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="issueModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 shadow">
            <div class="modal-header border-0">
                <h5 class="modal-title"><span data-i18n="issueModalTitlePrefix">Xuất — </span><span id="issueBarcodeLabel"></span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="Issue" asp-action="Scan" method="post">
                <input type="hidden" name="materialId" id="issueMaterialId" />
                <input type="hidden" name="barcode" id="issueBarcode" />
                <div class="modal-body">
                    <p class="text-muted small mb-3"><span data-i18n="currentBalanceLabel">Tồn hiện tại:</span> <span id="issueBalanceLabel" class="fw-semibold"></span></p>

                    <label class="form-label small fw-semibold text-secondary" data-i18n="recipientLabel">Nơi nhận</label>
                    <select name="recipientId" id="recipientSelect" class="form-select mb-3" required>
                        @foreach (var r in Model.Recipients)
                        {
                            <option value="@r.RecipientId">@r.Name</option>
                        }
                    </select>

                    <label class="form-label small fw-semibold text-secondary" data-i18n="issueQtyLabel">Số lượng xuất</label>
                    <input type="number" name="qty" id="issueQty" class="form-control" step="0.01" min="0.01" required />
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal" data-i18n="btnCancel">Hủy</button>
                    <button type="submit" class="btn pmc-btn-dark d-inline-flex align-items-center gap-1">
                        <span class="material-icons" style="font-size:18px;">check</span> <span data-i18n="btnConfirm">Xác nhận</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<div id="pmc-flash"
     data-success="@(ViewData["FlashSuccess"] as string)"
     data-error="@(ViewData["FlashError"] as string)"
     style="display:none"></div>

@section Scripts {
    <script>
        (function () {
            var flash = document.getElementById('pmc-flash');
            if (flash.dataset.success) PmcUI.success(PmcWhI18n.renderFlash(flash.dataset.success));
            if (flash.dataset.error) PmcUI.error(PmcWhI18n.renderFlash(flash.dataset.error));

            // Bảng liệt kê liệu dùng chung cột với Materials/Index — cần init tooltip giống hệt cho
            // các ô bị cắt chữ (Supplier, Mat'l Description, Remark...) mới hiện được khi hover.
            document.querySelectorAll('#materialsTable [data-bs-toggle="tooltip"]').forEach(function (el) {
                if (el.getAttribute('title')) {
                    new bootstrap.Tooltip(el);
                }
            });

            var items = @Html.Raw(itemsJson);
            var byId = {};
            items.forEach(function (it) { byId[it.materialId] = it; });

            var issueModal = new bootstrap.Modal(document.getElementById('issueModal'));

            function openIssueFor(materialId, barcode) {
                var item = byId[materialId];
                document.getElementById('issueMaterialId').value = materialId;
                document.getElementById('issueBarcode').value = barcode;
                document.getElementById('issueBarcodeLabel').textContent = barcode;
                document.getElementById('issueBalanceLabel').textContent = item ? (item.balance + ' ' + (item.unit || '')) : '';
                var qtyInput = document.getElementById('issueQty');
                qtyInput.value = item ? item.balance : '';
                qtyInput.max = item ? item.balance : '';
                issueModal.show();
            }

            document.querySelectorAll('.js-open-issue').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    openIssueFor(btn.dataset.materialId, btn.dataset.barcode);
                });
            });

            var issueForm = document.querySelector('#issueModal form');
            issueForm.addEventListener('submit', function () {
                issueForm.querySelector('button[type="submit"]').disabled = true;
            });

            var scanInput = document.getElementById('scanInput');
            scanInput.addEventListener('keydown', function (e) {
                if (e.key !== 'Enter') return;
                e.preventDefault();
                var code = scanInput.value.trim();
                scanInput.value = '';
                if (!code) return;

                var row = document.querySelector('.js-issuable-row[data-barcode="' + CSS.escape(code) + '"]');
                if (!row) {
                    PmcUI.error(PmcWhI18n.t('notFoundIssuable').replace('{code}', code));
                    return;
                }
                var btn = row.querySelector('.js-open-issue');
                openIssueFor(btn.dataset.materialId, btn.dataset.barcode);
            });

            // Draggable column resize — đồng bộ với Materials/Index, dùng chung 1 localStorage key
            // nên độ rộng cột kéo ở trang nào cũng áp dụng cho các trang liệt kê liệu khác.
            (function () {
                var STORAGE_KEY = 'pmc_materials_col_widths_v1';
                var table = document.getElementById('materialsTable');
                if (!table) return;

                function colFor(key) {
                    return table.querySelector('col[data-col-key="' + key + '"]');
                }

                var saved = {};
                try { saved = JSON.parse(localStorage.getItem(STORAGE_KEY)) || {}; } catch (e) { saved = {}; }
                Object.keys(saved).forEach(function (key) {
                    var col = colFor(key);
                    if (col && saved[key] > 0) col.style.width = saved[key] + 'px';
                });

                function saveWidths() {
                    var widths = {};
                    table.querySelectorAll('col[data-col-key]').forEach(function (col) {
                        widths[col.dataset.colKey] = col.getBoundingClientRect().width;
                    });
                    localStorage.setItem(STORAGE_KEY, JSON.stringify(widths));
                }

                table.querySelectorAll('.col-resizer').forEach(function (resizer) {
                    resizer.addEventListener('mousedown', function (e) {
                        e.preventDefault();
                        var col = colFor(resizer.dataset.colKey);
                        if (!col) return;
                        var startX = e.clientX;
                        var startWidth = col.getBoundingClientRect().width;
                        resizer.classList.add('is-resizing');
                        document.body.classList.add('pmc-col-resizing');

                        function onMove(ev) {
                            var newWidth = Math.max(40, startWidth + (ev.clientX - startX));
                            col.style.width = newWidth + 'px';
                        }
                        function onUp() {
                            document.removeEventListener('mousemove', onMove);
                            document.removeEventListener('mouseup', onUp);
                            resizer.classList.remove('is-resizing');
                            document.body.classList.remove('pmc-col-resizing');
                            saveWidths();
                        }
                        document.addEventListener('mousemove', onMove);
                        document.addEventListener('mouseup', onUp);
                    });
                });
            })();
        })();
    </script>
}
