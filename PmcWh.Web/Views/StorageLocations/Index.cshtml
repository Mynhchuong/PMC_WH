@model PmcWh.Web.Models.StorageLocationListViewModel
@{
    ViewData["Title"] = "Quản lý kệ";
    ViewData["TitleKey"] = "menuStorageLocations";
}

<div class="card border-0 shadow-sm rounded-4 mb-3">
    <div class="card-body">
        <div class="d-flex align-items-center gap-3 mb-4">
            <span class="d-inline-flex align-items-center justify-content-center rounded-4"
                  style="width:48px;height:48px;background:linear-gradient(135deg, #795548 0%, #4e342e 100%); flex-shrink:0;">
                <span class="material-icons text-white">shelves</span>
            </span>
            <div>
                <h5 class="card-title mb-0" data-i18n="addLocationTitle">Thêm kệ / tầng</h5>
                <p class="text-muted small mb-0" data-i18n="addLocationSubtitle">Số kệ + số tầng chưa có sẽ hiện lên combobox lúc quét lên kệ và bản đồ kho 3D</p>
            </div>
        </div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger d-flex align-items-center gap-2" role="alert">
                <span class="material-icons">error_outline</span>
                <div>
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <div>@error.ErrorMessage</div>
                    }
                </div>
            </div>
        }

        <form asp-controller="StorageLocations" asp-action="Create" method="post" class="row g-3 align-items-end">
            <input type="hidden" name="showInactive" value="@(Model.ShowInactive.ToString())" />
            <input type="hidden" name="q" value="@Model.SearchQuery" />
            <div class="col-6 col-md-1">
                <label asp-for="NewLocation.RackNo" class="form-label small fw-semibold text-secondary" data-i18n="colRackNo"></label>
                <input asp-for="NewLocation.RackNo" type="number" min="1" class="form-control" placeholder="14" />
            </div>
            <div class="col-6 col-md-1">
                <label asp-for="NewLocation.LevelNo" class="form-label small fw-semibold text-secondary" data-i18n="colLevelNo"></label>
                <input asp-for="NewLocation.LevelNo" type="number" min="1" class="form-control" placeholder="5" />
            </div>
            <div class="col-sm-6 col-md-2">
                <label asp-for="NewLocation.ManagerName" class="form-label small fw-semibold text-secondary" data-i18n="colManager"></label>
                <input asp-for="NewLocation.ManagerName" class="form-control" placeholder="Chị Lan" />
            </div>
            <div class="col-sm-6 col-md-2">
                <label asp-for="NewLocation.PurposeVi" class="form-label small fw-semibold text-secondary" data-i18n="colPurposeVi"></label>
                <input asp-for="NewLocation.PurposeVi" class="form-control" placeholder="Chứa vải" />
            </div>
            <div class="col-sm-6 col-md-2">
                <label asp-for="NewLocation.PurposeEn" class="form-label small fw-semibold text-secondary" data-i18n="colPurposeEn"></label>
                <input asp-for="NewLocation.PurposeEn" class="form-control" placeholder="Fabric storage" />
            </div>
            <div class="col-sm-6 col-md-2">
                <label asp-for="NewLocation.Note" class="form-label small fw-semibold text-secondary" data-i18n="colNote"></label>
                <input asp-for="NewLocation.Note" class="form-control" />
            </div>
            <div class="col-sm-6 col-md-2">
                <button type="submit" class="btn pmc-btn-dark w-100 d-inline-flex align-items-center justify-content-center gap-1">
                    <span class="material-icons" style="font-size:18px;">add</span> <span data-i18n="btnAdd">Thêm</span>
                </button>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body">
        <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
            <h5 class="card-title mb-0" data-i18n="locationListTitle">Danh sách kệ</h5>
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <a asp-controller="StorageLocations" asp-action="ExportExcel" class="btn btn-sm btn-info text-white d-inline-flex align-items-center gap-1">
                    <span class="material-icons" style="font-size:15px;">file_download</span> <span data-i18n="btnExportExcel">Xuất Excel</span>
                </a>
                <button type="button" class="btn btn-sm btn-warning text-white d-inline-flex align-items-center gap-1" data-bs-toggle="modal" data-bs-target="#importLocationsModal">
                    <span class="material-icons" style="font-size:15px;">cloud_upload</span> <span data-i18n="btnImportExcel">Import Excel</span>
                </button>
                <a asp-controller="StorageLocations" asp-action="Index" asp-route-showInactive="@(!Model.ShowInactive)" asp-route-q="@Model.SearchQuery"
                   class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1">
                    <span class="material-icons" style="font-size:16px;">@(Model.ShowInactive ? "visibility_off" : "visibility")</span>
                    <span data-i18n="@(Model.ShowInactive ? "btnHideInactiveLocations" : "btnShowInactiveLocations")">@(Model.ShowInactive ? "Ẩn kệ đã tắt" : "Hiện cả kệ đã ẩn")</span>
                </a>
            </div>
        </div>

        <form asp-controller="StorageLocations" asp-action="Index" method="get" class="d-flex align-items-center gap-2 mb-3 flex-wrap">
            <input type="hidden" name="showInactive" value="@(Model.ShowInactive.ToString())" />
            <div class="input-group" style="max-width:360px;">
                <span class="input-group-text bg-white"><span class="material-icons" style="font-size:18px;">search</span></span>
                <input type="text" name="q" value="@Model.SearchQuery" class="form-control"
                       data-i18n-placeholder="filterLocationPlaceholder" placeholder="Tìm theo mã kệ, người quản lý, công dụng..." />
                <button type="submit" class="btn btn-outline-secondary" title="Tìm" data-i18n-title="btnSearchTooltip">
                    <span class="material-icons" style="font-size:18px;">search</span>
                </button>
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.SearchQuery))
            {
                <a asp-controller="StorageLocations" asp-action="Index" asp-route-showInactive="@Model.ShowInactive"
                   class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1">
                    <span class="material-icons" style="font-size:15px;">filter_alt_off</span> <span data-i18n="btnClearFilter">Bỏ lọc</span>
                </a>
            }
        </form>

        <div class="table-responsive pmc-table-scroll">
            <table class="table align-middle table-sm">
                <thead>
                    <tr class="text-uppercase text-muted small">
                        <th data-i18n="colCode">Mã kệ</th>
                        <th data-i18n="colManager">Người quản lý</th>
                        <th data-i18n="colPurposeVi">Công dụng (VI)</th>
                        <th data-i18n="colPurposeEn">Purpose (EN)</th>
                        <th data-i18n="colNote">Ghi chú</th>
                        <th data-i18n="colStatus">Trạng thái</th>
                        <th class="text-end" data-i18n="colAction">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var l in Model.Items)
                    {
                        <tr>
                            <td class="fw-semibold" style="font-family:monospace;">@l.Code</td>
                            <td>@(string.IsNullOrWhiteSpace(l.ManagerName) ? "—" : l.ManagerName)</td>
                            <td>@(string.IsNullOrWhiteSpace(l.PurposeVi) ? "—" : l.PurposeVi)</td>
                            <td>@(string.IsNullOrWhiteSpace(l.PurposeEn) ? "—" : l.PurposeEn)</td>
                            <td class="text-muted small">@(string.IsNullOrWhiteSpace(l.Note) ? "—" : l.Note)</td>
                            <td>
                                @if (l.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactive</span>
                                }
                            </td>
                            <td class="text-end">
                                <button type="button" class="btn btn-sm btn-outline-secondary js-edit-location-btn"
                                        data-id="@l.LocationId" data-code="@l.Code" title="Sửa" data-i18n-title="editTooltip">
                                    <span class="material-icons" style="font-size:16px;">edit</span>
                                </button>
                                <form asp-controller="StorageLocations" asp-action="ToggleActive" method="post" class="d-inline js-toggle-location-form">
                                    <input type="hidden" name="locationId" value="@l.LocationId" />
                                    <input type="hidden" name="code" value="@l.Code" />
                                    <input type="hidden" name="showInactive" value="@(Model.ShowInactive.ToString())" />
                                    <input type="hidden" name="q" value="@Model.SearchQuery" />
                                    <button type="submit" class="btn btn-sm @(l.IsActive ? "btn-outline-secondary" : "btn-outline-success")" data-i18n="@(l.IsActive ? "btnDisable" : "btnEnable")">
                                        @(l.IsActive ? "Tắt" : "Bật lại")
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                    @if (Model.Items.Count == 0)
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4" data-i18n="emptyLocations">Chưa có kệ nào.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="mt-3">
            @await Html.PartialAsync("_Pagination", Model.Pagination)
        </div>
    </div>
</div>

<div class="modal fade" id="importLocationsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 shadow">
            <div class="modal-header border-0">
                <h5 class="modal-title" data-i18n="importLocationsModalTitle">Import kệ từ Excel</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="StorageLocations" asp-action="Index" method="post" enctype="multipart/form-data">
                <input type="hidden" name="showInactive" value="@(Model.ShowInactive.ToString())" />
                <input type="hidden" name="q" value="@Model.SearchQuery" />
                <div class="modal-body">
                    <label class="form-label small fw-semibold text-secondary mb-1" data-i18n="chooseExcelFile">Chọn file Excel (.xlsx)</label>
                    <input type="file" name="file" accept=".xlsx" class="form-control" required />
                    <p class="text-muted small mt-2 mb-0" data-i18n="importLocationsHint">Dùng file "Xuất Excel" ở trên, sửa lại rồi import — kệ đã có (khớp SỐ KỆ + SỐ TẦNG) sẽ được cập nhật, chưa có sẽ tự thêm mới.</p>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal" data-i18n="btnCancel">Hủy</button>
                    <button type="submit" class="btn pmc-btn-dark d-inline-flex align-items-center gap-1">
                        <span class="material-icons" style="font-size:18px;">cloud_upload</span> <span data-i18n="btnImport">Import</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@if (Model.ImportSkipped is { Count: > 0 })
{
    <script type="application/json" id="pmc-import-locations-skipped-data">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ImportSkipped))</script>
    <div id="pmc-import-locations-result"
         data-inserted="@Model.ImportInsertedCount"
         data-updated="@Model.ImportUpdatedCount"
         data-total="@Model.ImportTotalCount"
         data-skipped-count="@(Model.ImportSkippedCount ?? Model.ImportSkipped!.Count)"
         style="display:none"></div>
}

<div class="modal fade" id="editLocationModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 shadow">
            <div class="modal-header border-0">
                <h5 class="modal-title" data-i18n="editLocationModalTitle">Sửa thông tin kệ</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="StorageLocations" asp-action="Edit" method="post" id="editLocationForm">
                <input type="hidden" name="locationId" id="editLoc_LocationId" />
                <input type="hidden" name="code" id="editLoc_Code" />
                <input type="hidden" name="showInactive" value="@(Model.ShowInactive.ToString())" />
                <input type="hidden" name="q" value="@Model.SearchQuery" />
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary mb-1" data-i18n="colCode">Mã kệ</label>
                        <input class="form-control" style="font-family:monospace;" id="editLoc_CodeDisplay" disabled />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary mb-1" data-i18n="colManager">Người quản lý</label>
                        <input class="form-control" name="managerName" id="editLoc_ManagerName" maxlength="120" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary mb-1" data-i18n="colPurposeVi">Công dụng (VI)</label>
                        <input class="form-control" name="purposeVi" id="editLoc_PurposeVi" maxlength="400" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary mb-1" data-i18n="colPurposeEn">Purpose (EN)</label>
                        <input class="form-control" name="purposeEn" id="editLoc_PurposeEn" maxlength="400" />
                    </div>
                    <div class="mb-0">
                        <label class="form-label small fw-semibold text-secondary mb-1" data-i18n="colNote">Ghi chú</label>
                        <input class="form-control" name="note" id="editLoc_Note" maxlength="400" />
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal" data-i18n="btnCancel">Hủy</button>
                    <button type="submit" class="btn pmc-btn-dark" data-i18n="btnSave">Lưu</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div id="pmc-flash"
     data-success="@(ViewData["FlashSuccess"] as string)"
     data-warning="@(ViewData["FlashWarning"] as string)"
     data-error="@(ViewData["FlashError"] as string)"
     style="display:none"></div>

@section Scripts {
    <script>
        (function () {
            var flash = document.getElementById('pmc-flash');
            if (flash.dataset.success) PmcUI.success(PmcWhI18n.renderFlash(flash.dataset.success));
            if (flash.dataset.warning) PmcUI.warning(PmcWhI18n.renderFlash(flash.dataset.warning));
            if (flash.dataset.error) PmcUI.error(PmcWhI18n.renderFlash(flash.dataset.error));

            // Import xong có kệ bị bỏ qua/lỗi -> hiện popup rõ ràng: thêm mới bao nhiêu, cập nhật
            // bao nhiêu, lỗi kệ nào (số kệ.số tầng) + lý do — cùng khuôn mẫu popup import ở
            // Materials/Index (xem PmcWh.Web StorageLocationsController.Index (POST)).
            var importResultEl = document.getElementById('pmc-import-locations-result');
            var importSkippedDataEl = document.getElementById('pmc-import-locations-skipped-data');
            if (importResultEl && importSkippedDataEl) {
                var skipped = JSON.parse(importSkippedDataEl.textContent);
                var inserted = importResultEl.dataset.inserted || '0';
                var updated = importResultEl.dataset.updated || '0';
                var total = importResultEl.dataset.total || '0';
                var skippedCount = parseInt(importResultEl.dataset.skippedCount, 10) || skipped.length;
                var rowsHtml = skipped.map(function (s) {
                    return '<tr><td class="fw-semibold" style="font-family:monospace;">' + PmcUI.escapeHtml(s.Code) + '</td><td>' + PmcUI.escapeHtml(s.Reason) + '</td></tr>';
                }).join('');
                var truncatedNote = skipped.length < skippedCount
                    ? '<div class="text-muted small mt-2">' + PmcWhI18n.t('importPopupTruncated').replace('{0}', skipped.length).replace('{1}', skippedCount) + '</div>'
                    : '';
                var body =
                    '<div class="d-flex gap-2 mb-3 flex-wrap">' +
                        '<span class="badge bg-success-subtle text-success-emphasis">' + PmcWhI18n.t('importedLocationsBase').replace('{0}', inserted).replace('{1}', updated) + '</span>' +
                        '<span class="badge bg-danger-subtle text-danger-emphasis">' + PmcWhI18n.t('importPopupSkipped').replace('{0}', skippedCount).replace('{1}', total) + '</span>' +
                    '</div>' +
                    '<div class="table-responsive" style="max-height:340px;overflow-y:auto;">' +
                        '<table class="table table-sm align-middle mb-0">' +
                            '<thead><tr class="text-uppercase text-muted small"><th data-i18n="colCode">' + PmcWhI18n.t('colCode') + '</th><th data-i18n="colReason">' + PmcWhI18n.t('colReason') + '</th></tr></thead>' +
                            '<tbody>' + rowsHtml + '</tbody>' +
                        '</table>' +
                    '</div>' + truncatedNote;
                PmcUI.popup(PmcWhI18n.t('importPopupTitle'), body);
            }

            document.querySelectorAll('.js-toggle-location-form').forEach(function (form) {
                form.addEventListener('submit', async function (e) {
                    e.preventDefault();
                    var code = form.querySelector('input[name="code"]').value;
                    var ok = await PmcUI.confirm(PmcWhI18n.t('confirmToggleLocationMsg').replace('{0}', code), { title: PmcWhI18n.t('btnDisable') });
                    if (ok) form.submit();
                });
            });

            var editModalEl = document.getElementById('editLocationModal');
            if (editModalEl) {
                var editModal = new bootstrap.Modal(editModalEl);
                document.querySelectorAll('.js-edit-location-btn').forEach(function (btn) {
                    btn.addEventListener('click', async function () {
                        var id = btn.dataset.id;
                        try {
                            var loc = await PmcUI.withLoading(() =>
                                fetch('StorageLocations/' + id + '/EditData').then(function (r) {
                                    if (!r.ok) throw new Error('load failed');
                                    return r.json();
                                })
                            );
                            document.getElementById('editLoc_LocationId').value = loc.locationId;
                            document.getElementById('editLoc_Code').value = loc.code;
                            document.getElementById('editLoc_CodeDisplay').value = loc.code;
                            document.getElementById('editLoc_ManagerName').value = loc.managerName || '';
                            document.getElementById('editLoc_PurposeVi').value = loc.purposeVi || '';
                            document.getElementById('editLoc_PurposeEn').value = loc.purposeEn || '';
                            document.getElementById('editLoc_Note').value = loc.note || '';
                            editModal.show();
                        } catch (err) {
                            PmcUI.error(PmcWhI18n.t('loadLocationInfoError'));
                        }
                    });
                });
            }
        })();
    </script>
}
