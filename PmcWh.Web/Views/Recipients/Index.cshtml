@model PmcWh.Web.Models.RecipientListViewModel
@{
    ViewData["Title"] = "Nơi nhận";
    ViewData["TitleKey"] = "menuRecipients";
}

<div class="card border-0 shadow-sm rounded-4 mb-3">
    <div class="card-body">
        <div class="d-flex align-items-center gap-3 mb-4">
            <span class="d-inline-flex align-items-center justify-content-center rounded-4"
                  style="width:48px;height:48px;background:linear-gradient(135deg, #0dcaf0 0%, #087990 100%); flex-shrink:0;">
                <span class="material-icons text-white">add_location_alt</span>
            </span>
            <div>
                <h5 class="card-title mb-0" data-i18n="addRecipientTitle">Thêm nơi nhận</h5>
                <p class="text-muted small mb-0" data-i18n="addRecipientSubtitle">Danh sách nơi nhận hiện lên combobox lúc xuất hàng (DEV / Workshop / ...)</p>
            </div>
        </div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger d-flex align-items-center gap-2" role="alert">
                <span class="material-icons">error_outline</span>
                <div>
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <div>@error.ErrorMessage</div>
                    }
                </div>
            </div>
        }

        <form asp-controller="Recipients" asp-action="Create" method="post" class="row g-3 align-items-end">
            <div class="col-sm-8 col-md-4">
                <label asp-for="NewRecipient.Name" class="form-label small fw-semibold text-secondary" data-i18n="recipientLabel"></label>
                <div class="input-group">
                    <span class="input-group-text bg-white"><span class="material-icons" style="font-size:18px;">place</span></span>
                    <input asp-for="NewRecipient.Name" class="form-control" placeholder="Workshop, DEV, Laminate..." />
                </div>
            </div>
            <div class="col-sm-4 col-md-2">
                <button type="submit" class="btn pmc-btn-dark w-100 d-inline-flex align-items-center justify-content-center gap-1">
                    <span class="material-icons" style="font-size:18px;">add</span> <span data-i18n="btnAdd">Thêm</span>
                </button>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body">
        <h5 class="card-title mb-3" data-i18n="recipientListTitle">Danh sách nơi nhận</h5>

        <div class="table-responsive pmc-table-scroll">
            <table class="table align-middle">
                <thead>
                    <tr class="text-uppercase text-muted small">
                        <th data-i18n="recipientLabel">Nơi nhận</th>
                        <th data-i18n="colStatus">Trạng thái</th>
                        <th class="text-end" data-i18n="colAction">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.Items)
                    {
                        <tr>
                            <td class="fw-semibold">@r.Name</td>
                            <td>
                                @if (r.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactive</span>
                                }
                            </td>
                            <td class="text-end">
                                <form asp-controller="Recipients" asp-action="ToggleActive" method="post" class="d-inline">
                                    <input type="hidden" name="recipientId" value="@r.RecipientId" />
                                    <input type="hidden" name="name" value="@r.Name" />
                                    <button type="submit" class="btn btn-sm @(r.IsActive ? "btn-outline-secondary" : "btn-outline-success")" data-i18n="@(r.IsActive ? "btnDisable" : "btnEnable")">
                                        @(r.IsActive ? "Tắt" : "Bật lại")
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                    @if (Model.Items.Count == 0)
                    {
                        <tr>
                            <td colspan="3" class="text-center text-muted py-4" data-i18n="emptyRecipients">Chưa có nơi nhận nào.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="mt-3">
            @await Html.PartialAsync("_Pagination", Model.Pagination)
        </div>
    </div>
</div>

<div id="pmc-flash"
     data-success="@(ViewData["FlashSuccess"] as string)"
     data-error="@(ViewData["FlashError"] as string)"
     style="display:none"></div>

@section Scripts {
    <script>
        (function () {
            var flash = document.getElementById('pmc-flash');
            if (flash.dataset.success) PmcUI.success(PmcWhI18n.renderFlash(flash.dataset.success));
            if (flash.dataset.error) PmcUI.error(PmcWhI18n.renderFlash(flash.dataset.error));
        })();
    </script>
}
