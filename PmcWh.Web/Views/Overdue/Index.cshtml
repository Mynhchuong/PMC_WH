@using PmcWh.Web.Helpers
@model PmcWh.Web.Models.OverdueViewModel
@{
    ViewData["Title"] = "Hàng xuất quá 90 ngày";
    ViewData["TitleKey"] = "menuOverdue";
}

<div class="card border-0 shadow-sm rounded-4 mb-3">
    <div class="card-body">
        <div class="d-flex align-items-center gap-3 mb-2">
            <span class="d-inline-flex align-items-center justify-content-center rounded-4"
                  style="width:48px;height:48px;background:linear-gradient(135deg, #dc3545 0%, #842029 100%); flex-shrink:0;">
                <span class="material-icons text-white">warning_amber</span>
            </span>
            <div>
                <h5 class="card-title mb-0" data-i18n="overduePageTitle">Hàng xuất quá 90 ngày chưa nhận lại</h5>
                <p class="text-muted small mb-0" data-i18n="overdueSubtitle">Cả xuất 1 phần lẫn xuất hết — kiểm tra thực tế bên nhận: còn liệu thì để đó, hết liệu thì bấm Xóa.</p>
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body">
        <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
            <h5 class="card-title mb-0"><span data-i18n="listTitle">Danh sách</span> (@Model.Items.Count)</h5>
            <button type="button" id="btnBulkDelete" class="btn btn-sm btn-outline-danger d-inline-flex align-items-center gap-1" disabled>
                <span class="material-icons" style="font-size:16px;">delete_sweep</span>
                <span data-i18n="btnDeleteSelected">Xóa đã chọn</span>
                <span id="bulkSelectedCount" class="badge bg-danger ms-1" style="display:none;"></span>
            </button>
        </div>

        <form asp-controller="Overdue" asp-action="BulkDispose" method="post" id="bulkDisposeForm"></form>

        <div class="table-responsive pmc-table-scroll">
            <table id="materialsTable" class="table align-middle table-sm pmc-table-compact" style="table-layout: fixed;">
                <colgroup>
                    <col data-col-key="select" style="width: 36px">
                    @{ await Html.RenderPartialAsync("_MaterialColGroup"); }
                    <col data-col-key="recipient" style="width: 120px">
                    <col data-col-key="balance" style="width: 90px">
                    <col data-col-key="status" style="width: 130px">
                    <col data-col-key="shelf" style="width: 100px">
                    <col data-col-key="daysOut" style="width: 90px">
                    <col data-col-key="action" style="width: 110px">
                </colgroup>
                <thead>
                    <tr class="text-uppercase text-muted small">
                        <th>
                            <input type="checkbox" class="form-check-input" id="chkSelectAll" title="Chọn tất cả" data-i18n-title="selectAllLabel" />
                        </th>
                        @{ await Html.RenderPartialAsync("_MaterialColHeaders"); }
                        <th class="pmc-resizable-th"><span data-i18n="recipientLabel">Nơi nhận</span><span class="col-resizer" data-col-key="recipient"></span></th>
                        <th class="pmc-resizable-th text-end"><span data-i18n="colRemaining">Còn lại</span><span class="col-resizer" data-col-key="balance"></span></th>
                        <th class="pmc-resizable-th"><span data-i18n="colStatus">Trạng thái</span><span class="col-resizer" data-col-key="status"></span></th>
                        <th class="pmc-resizable-th"><span data-i18n="colCurrentShelf">Kệ hiện tại</span><span class="col-resizer" data-col-key="shelf"></span></th>
                        <th class="pmc-resizable-th text-end"><span data-i18n="colDaysOut">Số ngày</span><span class="col-resizer" data-col-key="daysOut"></span></th>
                        <th class="pmc-resizable-th text-end"><span data-i18n="colAction">Hành động</span><span class="col-resizer" data-col-key="action"></span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in Model.Items)
                    {
                        <tr class="js-overdue-row js-detail-row" data-material-id="@m.MaterialId" data-barcode="@m.Barcode" title="Double-click để xem chi tiết">
                            <td onclick="event.stopPropagation();">
                                <input type="checkbox" class="form-check-input js-overdue-check" value="@m.MaterialId" />
                            </td>
                            @{ await Html.RenderPartialAsync("_MaterialColCells", m); }
                            <td>@(m.RecipientName ?? "—")</td>
                            <td class="text-end">@m.Balance @m.Unit</td>
                            <td>
                                @{ var (badgeTextClass, badgeStyle) = MaterialStatusHelper.BadgeStyle(m.Status); }
                                <span class="badge @badgeTextClass" style="@badgeStyle" data-i18n="@("status" + m.Status)">@MaterialStatusHelper.Label(m.Status)</span>
                            </td>
                            <td>@(m.LocationCode ?? "—")</td>
                            <td class="text-end">@m.DaysOut<span data-i18n="daysWord"> ngày</span></td>
                            <td class="text-end">
                                <form asp-controller="Overdue" asp-action="Scan" method="post" class="d-inline js-overdue-form">
                                    <input type="hidden" name="materialId" value="@m.MaterialId" />
                                    <input type="hidden" name="barcode" value="@m.Barcode" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger" data-i18n="btnDelete">Xóa</button>
                                </form>
                            </td>
                        </tr>
                    }
                    @if (Model.Items.Count == 0)
                    {
                        <tr>
                            <td colspan="25" class="text-center text-muted py-4" data-i18n="emptyOverdue">Không có liệu nào quá 90 ngày.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="mt-3">
            @await Html.PartialAsync("_Pagination", Model.Pagination)
        </div>
    </div>
</div>

<div id="pmc-flash"
     data-success="@(ViewData["FlashSuccess"] as string)"
     data-error="@(ViewData["FlashError"] as string)"
     style="display:none"></div>

@section Scripts {
    <script>
        (function () {
            var flash = document.getElementById('pmc-flash');
            if (flash.dataset.success) PmcUI.success(PmcWhI18n.renderFlash(flash.dataset.success));
            if (flash.dataset.error) PmcUI.error(PmcWhI18n.renderFlash(flash.dataset.error));

            // Bảng dùng chung cột với Materials/Index — cần init tooltip giống hệt cho các ô bị
            // cắt chữ (Mat'l Description, Remark...) mới hiện được khi hover.
            document.querySelectorAll('#materialsTable [data-bs-toggle="tooltip"]').forEach(function (el) {
                if (el.getAttribute('title')) {
                    new bootstrap.Tooltip(el);
                }
            });

            document.querySelectorAll('.js-overdue-form').forEach(function (form) {
                form.addEventListener('submit', async function (e) {
                    e.preventDefault();
                    var barcode = form.querySelector('input[name="barcode"]').value;
                    var ok = await PmcUI.confirmDelete(PmcWhI18n.t('confirmOverdueDeleteMsg').replace('{barcode}', barcode));
                    if (ok) {
                        form.querySelector('button[type="submit"]').disabled = true;
                        form.submit();
                    }
                });
            });

            // Chọn tất cả + xóa hàng loạt.
            var selectAll = document.getElementById('chkSelectAll');
            var rowChecks = Array.prototype.slice.call(document.querySelectorAll('.js-overdue-check'));
            var bulkBtn = document.getElementById('btnBulkDelete');
            var bulkCountBadge = document.getElementById('bulkSelectedCount');
            var bulkForm = document.getElementById('bulkDisposeForm');

            function updateBulkUi() {
                var checked = rowChecks.filter(function (c) { return c.checked; });
                bulkBtn.disabled = checked.length === 0;
                if (checked.length > 0) {
                    bulkCountBadge.textContent = PmcWhI18n.t('selectedCountLabel').replace('{0}', checked.length);
                    bulkCountBadge.style.display = '';
                } else {
                    bulkCountBadge.style.display = 'none';
                }
                if (selectAll) {
                    selectAll.checked = rowChecks.length > 0 && checked.length === rowChecks.length;
                    selectAll.indeterminate = checked.length > 0 && checked.length < rowChecks.length;
                }
            }

            if (selectAll) {
                selectAll.addEventListener('change', function () {
                    rowChecks.forEach(function (c) { c.checked = selectAll.checked; });
                    updateBulkUi();
                });
            }
            rowChecks.forEach(function (c) { c.addEventListener('change', updateBulkUi); });
            updateBulkUi();

            if (bulkBtn) {
                bulkBtn.addEventListener('click', async function () {
                    var checked = rowChecks.filter(function (c) { return c.checked; });
                    if (checked.length === 0) return;
                    var ok = await PmcUI.confirmDelete(PmcWhI18n.t('confirmBulkOverdueDeleteMsg').replace('{0}', checked.length));
                    if (!ok) return;
                    // Chỉ xoá input materialIds cũ (nếu bấm lại lần 2) — KHÔNG dùng innerHTML=''
                    // vì sẽ xoá luôn hidden input antiforgery token do asp-action tự chèn sẵn.
                    bulkForm.querySelectorAll('input[name="materialIds"]').forEach(function (el) { el.remove(); });
                    checked.forEach(function (c) {
                        var input = document.createElement('input');
                        input.type = 'hidden';
                        input.name = 'materialIds';
                        input.value = c.value;
                        bulkForm.appendChild(input);
                    });
                    bulkBtn.disabled = true;
                    bulkForm.submit();
                });
            }

            // Draggable column resize — đồng bộ với Materials/Index (dùng chung 1 localStorage key
            // nên độ rộng cột kéo ở trang nào cũng áp dụng cho các trang liệt kê liệu khác).
            (function () {
                var STORAGE_KEY = 'pmc_materials_col_widths_v1';
                var table = document.getElementById('materialsTable');
                if (!table) return;

                function colFor(key) {
                    return table.querySelector('col[data-col-key="' + key + '"]');
                }

                var saved = {};
                try { saved = JSON.parse(localStorage.getItem(STORAGE_KEY)) || {}; } catch (e) { saved = {}; }
                Object.keys(saved).forEach(function (key) {
                    var col = colFor(key);
                    if (col && saved[key] > 0) col.style.width = saved[key] + 'px';
                });

                function saveWidths() {
                    var widths = {};
                    table.querySelectorAll('col[data-col-key]').forEach(function (col) {
                        widths[col.dataset.colKey] = col.getBoundingClientRect().width;
                    });
                    localStorage.setItem(STORAGE_KEY, JSON.stringify(widths));
                }

                table.querySelectorAll('.col-resizer').forEach(function (resizer) {
                    resizer.addEventListener('mousedown', function (e) {
                        e.preventDefault();
                        var col = colFor(resizer.dataset.colKey);
                        if (!col) return;
                        var startX = e.clientX;
                        var startWidth = col.getBoundingClientRect().width;
                        resizer.classList.add('is-resizing');
                        document.body.classList.add('pmc-col-resizing');

                        function onMove(ev) {
                            var newWidth = Math.max(40, startWidth + (ev.clientX - startX));
                            col.style.width = newWidth + 'px';
                        }
                        function onUp() {
                            document.removeEventListener('mousemove', onMove);
                            document.removeEventListener('mouseup', onUp);
                            resizer.classList.remove('is-resizing');
                            document.body.classList.remove('pmc-col-resizing');
                            saveWidths();
                        }
                        document.addEventListener('mousemove', onMove);
                        document.addEventListener('mouseup', onUp);
                    });
                });
            })();
        })();
    </script>
}
