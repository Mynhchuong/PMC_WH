@using PmcWh.Web.Helpers
@model PmcWh.Web.Models.OverdueViewModel
@{
    ViewData["Title"] = "Hàng xuất quá 90 ngày";
    ViewData["TitleKey"] = "menuOverdue";
}

<div class="card border-0 shadow-sm rounded-4 mb-3">
    <div class="card-body">
        <div class="d-flex align-items-center gap-3 mb-2">
            <span class="d-inline-flex align-items-center justify-content-center rounded-4"
                  style="width:48px;height:48px;background:linear-gradient(135deg, #dc3545 0%, #842029 100%); flex-shrink:0;">
                <span class="material-icons text-white">warning_amber</span>
            </span>
            <div>
                <h5 class="card-title mb-0" data-i18n="overduePageTitle">Hàng xuất quá 90 ngày chưa nhận lại</h5>
                <p class="text-muted small mb-0" data-i18n="overdueSubtitle">Cả xuất 1 phần lẫn xuất hết — kiểm tra thực tế bên nhận: còn liệu thì để đó, hết liệu thì bấm Xóa.</p>
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body">
        <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
            <h5 class="card-title mb-0"><span data-i18n="listTitle">Danh sách</span> (@Model.Items.Count)</h5>
            <button type="button" id="btnBulkDelete" class="btn btn-sm btn-outline-danger d-inline-flex align-items-center gap-1" disabled>
                <span class="material-icons" style="font-size:16px;">delete_sweep</span>
                <span data-i18n="btnDeleteSelected">Xóa đã chọn</span>
                <span id="bulkSelectedCount" class="badge bg-danger ms-1" style="display:none;"></span>
            </button>
        </div>

        <form asp-controller="Overdue" asp-action="BulkDispose" method="post" id="bulkDisposeForm"></form>

        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr class="text-uppercase text-muted small">
                        <th style="width:36px;">
                            <input type="checkbox" class="form-check-input" id="chkSelectAll" title="Chọn tất cả" data-i18n-title="selectAllLabel" />
                        </th>
                        <th>Barcode</th>
                        <th>Dev</th>
                        <th>PO</th>
                        <th data-i18n="colMatlDescription">Mat'l Description</th>
                        <th data-i18n="recipientLabel">Nơi nhận</th>
                        <th class="text-end" data-i18n="colRemaining">Còn lại</th>
                        <th data-i18n="colStatus">Trạng thái</th>
                        <th data-i18n="colCurrentShelf">Kệ hiện tại</th>
                        <th class="text-end" data-i18n="colDaysOut">Số ngày</th>
                        <th class="text-end" data-i18n="colAction">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in Model.Items)
                    {
                        <tr class="js-overdue-row js-detail-row" data-material-id="@m.MaterialId" data-barcode="@m.Barcode" title="Double-click để xem chi tiết">
                            <td onclick="event.stopPropagation();">
                                <input type="checkbox" class="form-check-input js-overdue-check" value="@m.MaterialId" />
                            </td>
                            <td class="fw-semibold">@m.Barcode</td>
                            <td>@m.Dev</td>
                            <td>@m.PoNo</td>
                            <td>@m.MatlDescription</td>
                            <td>@(m.RecipientName ?? "—")</td>
                            <td class="text-end">@m.Balance @m.Unit</td>
                            <td>
                                @{ var (badgeTextClass, badgeStyle) = MaterialStatusHelper.BadgeStyle(m.Status); }
                                <span class="badge @badgeTextClass" style="@badgeStyle" data-i18n="@("status" + m.Status)">@MaterialStatusHelper.Label(m.Status)</span>
                            </td>
                            <td>@(m.LocationCode ?? "—")</td>
                            <td class="text-end">@m.DaysOut<span data-i18n="daysWord"> ngày</span></td>
                            <td class="text-end">
                                <form asp-controller="Overdue" asp-action="Scan" method="post" class="d-inline js-overdue-form">
                                    <input type="hidden" name="materialId" value="@m.MaterialId" />
                                    <input type="hidden" name="barcode" value="@m.Barcode" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger" data-i18n="btnDelete">Xóa</button>
                                </form>
                            </td>
                        </tr>
                    }
                    @if (Model.Items.Count == 0)
                    {
                        <tr>
                            <td colspan="11" class="text-center text-muted py-4" data-i18n="emptyOverdue">Không có liệu nào quá 90 ngày.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div id="pmc-flash"
     data-success="@(ViewData["FlashSuccess"] as string)"
     data-error="@(ViewData["FlashError"] as string)"
     style="display:none"></div>

@section Scripts {
    <script>
        (function () {
            var flash = document.getElementById('pmc-flash');
            if (flash.dataset.success) PmcUI.success(PmcWhI18n.renderFlash(flash.dataset.success));
            if (flash.dataset.error) PmcUI.error(PmcWhI18n.renderFlash(flash.dataset.error));

            document.querySelectorAll('.js-overdue-form').forEach(function (form) {
                form.addEventListener('submit', async function (e) {
                    e.preventDefault();
                    var barcode = form.querySelector('input[name="barcode"]').value;
                    var ok = await PmcUI.confirmDelete(PmcWhI18n.t('confirmOverdueDeleteMsg').replace('{barcode}', barcode));
                    if (ok) {
                        form.querySelector('button[type="submit"]').disabled = true;
                        form.submit();
                    }
                });
            });

            // Chọn tất cả + xóa hàng loạt.
            var selectAll = document.getElementById('chkSelectAll');
            var rowChecks = Array.prototype.slice.call(document.querySelectorAll('.js-overdue-check'));
            var bulkBtn = document.getElementById('btnBulkDelete');
            var bulkCountBadge = document.getElementById('bulkSelectedCount');
            var bulkForm = document.getElementById('bulkDisposeForm');

            function updateBulkUi() {
                var checked = rowChecks.filter(function (c) { return c.checked; });
                bulkBtn.disabled = checked.length === 0;
                if (checked.length > 0) {
                    bulkCountBadge.textContent = PmcWhI18n.t('selectedCountLabel').replace('{0}', checked.length);
                    bulkCountBadge.style.display = '';
                } else {
                    bulkCountBadge.style.display = 'none';
                }
                if (selectAll) {
                    selectAll.checked = rowChecks.length > 0 && checked.length === rowChecks.length;
                    selectAll.indeterminate = checked.length > 0 && checked.length < rowChecks.length;
                }
            }

            if (selectAll) {
                selectAll.addEventListener('change', function () {
                    rowChecks.forEach(function (c) { c.checked = selectAll.checked; });
                    updateBulkUi();
                });
            }
            rowChecks.forEach(function (c) { c.addEventListener('change', updateBulkUi); });
            updateBulkUi();

            if (bulkBtn) {
                bulkBtn.addEventListener('click', async function () {
                    var checked = rowChecks.filter(function (c) { return c.checked; });
                    if (checked.length === 0) return;
                    var ok = await PmcUI.confirmDelete(PmcWhI18n.t('confirmBulkOverdueDeleteMsg').replace('{0}', checked.length));
                    if (!ok) return;
                    // Chỉ xoá input materialIds cũ (nếu bấm lại lần 2) — KHÔNG dùng innerHTML=''
                    // vì sẽ xoá luôn hidden input antiforgery token do asp-action tự chèn sẵn.
                    bulkForm.querySelectorAll('input[name="materialIds"]').forEach(function (el) { el.remove(); });
                    checked.forEach(function (c) {
                        var input = document.createElement('input');
                        input.type = 'hidden';
                        input.name = 'materialIds';
                        input.value = c.value;
                        bulkForm.appendChild(input);
                    });
                    bulkBtn.disabled = true;
                    bulkForm.submit();
                });
            }
        })();
    </script>
}
