@using PmcWh.Web.Helpers
@model PmcWh.Web.Models.MaterialListViewModel
@{
    ViewData["Title"] = "Cơ sở dữ liệu của PMC";
    var statusOptions = MaterialStatusHelper.AllStatuses;
}

<div class="card border-0 shadow-sm rounded-4 mb-3">
    <div class="card-body">
        <div class="d-flex align-items-center gap-3 mb-4">
            <span class="d-inline-flex align-items-center justify-content-center rounded-4"
                  style="width:48px;height:48px;background:linear-gradient(135deg, #495057 0%, #212529 100%); flex-shrink:0;">
                <span class="material-icons text-white">storage</span>
            </span>
            <div>
                <h5 class="card-title mb-0">Cơ sở dữ liệu của PMC</h5>
                <p class="text-muted small mb-0">Toàn bộ liệu đã nhập vào hệ thống</p>
            </div>
        </div>

        <div class="d-flex flex-wrap align-items-center gap-2 mb-3 pb-3 border-bottom">
            <button type="button" class="btn pmc-btn-dark d-inline-flex align-items-center gap-1" data-bs-toggle="modal" data-bs-target="#importModal">
                <span class="material-icons" style="font-size:18px;">cloud_upload</span> Import
            </button>
            <a asp-controller="Materials" asp-action="DownloadTemplate" class="btn btn-outline-secondary d-inline-flex align-items-center gap-1">
                <span class="material-icons" style="font-size:18px;">download</span> Tải file mẫu
            </a>
        </div>

        <form asp-controller="Materials" asp-action="Index" method="get" class="row g-2 align-items-end">
            <div class="col-sm-6 col-md-3">
                <label class="form-label small fw-semibold text-secondary">Barcode</label>
                <div class="input-group">
                    <span class="input-group-text bg-white"><span class="material-icons" style="font-size:18px;">search</span></span>
                    <input type="text" name="barcode" value="@Model.Barcode" class="form-control" placeholder="Tìm theo barcode..." />
                </div>
            </div>
            <div class="col-sm-4 col-md-2">
                <label class="form-label small fw-semibold text-secondary">Trạng thái</label>
                <select name="status" class="form-select">
                    <option value="">Tất cả</option>
                    @foreach (var s in statusOptions)
                    {
                        <option value="@s" selected="@(Model.Status == s)">@MaterialStatusHelper.Label(s)</option>
                    }
                </select>
            </div>
            <div class="col-sm-4 col-md-2">
                <label class="form-label small fw-semibold text-secondary">Ngày nhập từ</label>
                <input type="date" name="fromDate" value="@Model.FromDate?.ToString("yyyy-MM-dd")" class="form-control" />
            </div>
            <div class="col-sm-4 col-md-2">
                <label class="form-label small fw-semibold text-secondary">Đến ngày</label>
                <input type="date" name="toDate" value="@Model.ToDate?.ToString("yyyy-MM-dd")" class="form-control" />
            </div>
            <div class="col-sm-4 col-md-1 d-flex align-items-center">
                <div class="form-check">
                    <input type="checkbox" name="isOverdue" value="true" class="form-check-input" id="isOverdueCheck" checked="@(Model.IsOverdue == true)" />
                    <label class="form-check-label small" for="isOverdueCheck">Quá 90 ngày</label>
                </div>
            </div>
            <div class="col-sm-4 col-md-2">
                <button type="submit" class="btn btn-outline-dark w-100 d-inline-flex align-items-center justify-content-center gap-1">
                    <span class="material-icons" style="font-size:18px;">filter_alt</span> Lọc
                </button>
            </div>
        </form>
    </div>
</div>

@if (Model.ImportSkipped is { Count: > 0 })
{
    <div class="card border-0 shadow-sm rounded-4 mb-3">
        <div class="card-body">
            <h6 class="card-title mb-3">Dòng bị bỏ qua ở lần import gần nhất (@Model.ImportSkipped.Count)</h6>
            <div class="table-responsive">
                <table class="table align-middle table-sm mb-0">
                    <thead>
                        <tr class="text-uppercase text-muted small">
                            <th>Barcode</th>
                            <th>Lý do</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Model.ImportSkipped)
                        {
                            <tr>
                                <td class="fw-semibold">@s.Barcode</td>
                                <td>@s.Reason</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr class="text-uppercase text-muted small">
                        <th>Barcode</th>
                        <th>Dev</th>
                        <th>Model</th>
                        <th>Colorway</th>
                        <th>Size</th>
                        <th class="text-end">A.Qty</th>
                        <th>Trạng thái</th>
                        <th>Kệ hiện tại</th>
                        <th>Ngày nhập</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in Model.Items)
                    {
                        var (badgeTextClass, badgeStyle) = MaterialStatusHelper.BadgeStyle(m.Status);
                        <tr class="js-material-row" style="cursor:pointer;" data-id="@m.MaterialId" data-barcode="@m.Barcode" title="Double-click để xem chi tiết">
                            <td class="fw-semibold">@m.Barcode</td>
                            <td>@m.Dev</td>
                            <td>@m.Model</td>
                            <td>@m.Colorway</td>
                            <td>@m.SizeSpec</td>
                            <td class="text-end">@m.ArrivalQty @m.Unit</td>
                            <td>
                                <span class="badge @badgeTextClass" style="@badgeStyle">@MaterialStatusHelper.Label(m.Status)</span>
                                @if (m.IsOverdue)
                                {
                                    <span class="badge bg-danger ms-1">Quá 90 ngày</span>
                                }
                            </td>
                            <td>@(m.LocationCode ?? "—")</td>
                            <td class="text-muted small">@(m.ArrivalDate?.ToString("dd/MM/yyyy") ?? "—")</td>
                        </tr>
                    }
                    @if (Model.Items.Count == 0)
                    {
                        <tr>
                            <td colspan="9" class="text-center text-muted py-4">Không có dữ liệu phù hợp.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="mt-3">
            @await Html.PartialAsync("_Pagination", Model.Pagination)
        </div>
    </div>
</div>

<div class="modal fade" id="importModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 shadow">
            <div class="modal-header border-0">
                <h5 class="modal-title">Import liệu từ Excel</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="Materials" asp-action="Index" method="post" enctype="multipart/form-data">
                <div class="modal-body">
                    <label class="form-label small fw-semibold text-secondary">Chọn file Excel (.xlsx)</label>
                    <input type="file" name="file" accept=".xlsx" class="form-control" required />
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn pmc-btn-dark d-inline-flex align-items-center gap-1">
                        <span class="material-icons" style="font-size:18px;">cloud_upload</span> Import
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<div id="pmc-flash"
     data-success="@(ViewData["FlashSuccess"] as string)"
     data-warning="@(ViewData["FlashWarning"] as string)"
     data-error="@(ViewData["FlashError"] as string)"
     style="display:none"></div>

@section Scripts {
    <script>
        (function () {
            var flash = document.getElementById('pmc-flash');
            if (flash.dataset.success) PmcUI.success(flash.dataset.success);
            if (flash.dataset.warning) PmcUI.warning(flash.dataset.warning);
            if (flash.dataset.error) PmcUI.error(flash.dataset.error);

            document.querySelectorAll('.js-material-row').forEach(function (row) {
                row.addEventListener('dblclick', async function () {
                    var id = row.dataset.id;
                    var barcode = row.dataset.barcode;
                    try {
                        var html = await PmcUI.withLoading(() =>
                            fetch('/Materials/' + id + '/Detail').then(function (r) {
                                if (!r.ok) throw new Error('Không tải được chi tiết.');
                                return r.text();
                            })
                        );
                        PmcUI.popup('Chi tiết liệu — ' + barcode, html, { size: 'lg' });
                    } catch (e) {
                        PmcUI.error('Không tải được chi tiết liệu.');
                    }
                });
            });
        })();
    </script>
}
