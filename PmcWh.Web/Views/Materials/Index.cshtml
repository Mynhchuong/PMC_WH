@using PmcWh.Web.Helpers
@model PmcWh.Web.Models.MaterialListViewModel
@{
    ViewData["Title"] = "Cơ sở dữ liệu của PMC";
    ViewData["TitleKey"] = "matDbTitle";
    var statusOptions = MaterialStatusHelper.AllStatuses;
    var isAdmin = User.IsInRole("Admin");
    // Whitelist cột tìm kiếm hiển thị ở dropdown — phải khớp đúng các "case" đang được
    // PmcWh.Api MaterialsController.SearchColumnFor() chấp nhận, kẻo chọn 1 đằng tìm ra 1 nẻo.
    var searchFields = new (string Value, string I18nKey, string Label)[]
    {
        ("barcode", "colBarcode", "Barcode"),
        ("dev", "colDev", "Dev"),
        ("po", "colPo", "PO"),
        ("supplier", "colSupplier", "Supplier"),
        ("model", "colModel", "Model"),
        ("matldescription", "colMatlDescription", "Mat'l Description"),
        ("colorcode", "colColorCode", "Color Code"),
        ("colorway", "colColorway", "Colorway"),
        ("sizespec", "colSize", "Size"),
        ("category", "colCategory", "Category"),
        ("matltype", "colMatlType", "Mat'l Type"),
        ("pic", "colPic", "PIC"),
        ("remark", "colRemark", "Remark"),
    };
    var currentField = string.IsNullOrWhiteSpace(Model.Field) ? "barcode" : Model.Field;
}

<div class="card border-0 shadow-sm rounded-4 mb-2 pmc-filter-card">
    <div class="card-body py-2">
        <div class="d-flex align-items-center justify-content-between gap-2 mb-2 flex-wrap">
            <div class="d-flex align-items-center gap-2">
                <span class="d-inline-flex align-items-center justify-content-center rounded-3"
                      style="width:34px;height:34px;background:linear-gradient(135deg, #495057 0%, #212529 100%); flex-shrink:0;">
                    <span class="material-icons text-white" style="font-size:18px;">table_chart</span>
                </span>
                <div>
                    <h6 class="card-title mb-0" data-i18n="matDbTitle">Cơ sở dữ liệu của PMC</h6>
                    <p class="text-muted mb-0" style="font-size:0.7rem;" data-i18n="matDbSubtitle">Toàn bộ liệu đã nhập vào hệ thống</p>
                </div>
            </div>
            <div class="d-flex align-items-center gap-1 flex-wrap">
                @if (isAdmin)
                {
                    <button type="button" class="btn btn-sm btn-warning text-white d-inline-flex align-items-center gap-1" data-bs-toggle="modal" data-bs-target="#importModal">
                        <span class="material-icons" style="font-size:15px;">cloud_upload</span> <span data-i18n="btnImport">Import</span>
                    </button>
                    <a asp-controller="Materials" asp-action="DownloadTemplate" class="btn btn-sm btn-info text-white d-inline-flex align-items-center gap-1">
                        <span class="material-icons" style="font-size:15px;">download</span> <span data-i18n="btnDownloadTemplate">Tải file mẫu</span>
                    </a>
                }
                <a asp-controller="Materials" asp-action="ExportExcel"
                   asp-route-field="@Model.Field" asp-route-q="@Model.Q" asp-route-status="@Model.Status"
                   asp-route-fromDate="@Model.FromDate?.ToString("yyyy-MM-dd")" asp-route-toDate="@Model.ToDate?.ToString("yyyy-MM-dd")"
                   asp-route-isOverdue="@Model.IsOverdue"
                   class="btn btn-sm btn-success d-inline-flex align-items-center gap-1">
                    <span class="material-icons" style="font-size:15px;">file_download</span> <span data-i18n="btnExportExcel">Xuất Excel</span>
                </a>
            </div>
        </div>

        <form asp-controller="Materials" asp-action="Index" method="get" class="d-flex flex-wrap align-items-end gap-2">
            <div style="width:130px;">
                <label class="form-label small fw-semibold text-secondary mb-1" data-i18n="colSearchField">Tìm theo</label>
                <select name="field" class="form-select form-select-sm">
                    @foreach (var f in searchFields)
                    {
                        <option value="@f.Value" selected="@(currentField == f.Value)" data-i18n="@f.I18nKey">@f.Label</option>
                    }
                </select>
            </div>
            <div style="width:210px;">
                <label class="form-label small fw-semibold text-secondary mb-1" data-i18n="filterBarcodeLabel">Nội dung tìm</label>
                <div class="input-group input-group-sm">
                    <button type="submit" class="input-group-text bg-white" style="cursor:pointer;" title="Tìm kiếm" data-i18n-title="btnSearchTooltip">
                        <span class="material-icons" style="font-size:16px;">search</span>
                    </button>
                    <input type="text" name="q" value="@Model.Q" class="form-control" placeholder="Nhập nội dung cần tìm..." data-i18n-placeholder="filterBarcodePlaceholder" />
                </div>
            </div>
            <div style="width:130px;">
                <label class="form-label small fw-semibold text-secondary mb-1" data-i18n="filterStatusLabel">Trạng thái</label>
                <select name="status" class="form-select form-select-sm">
                    <option value="" data-i18n="filterStatusAll">Tất cả</option>
                    @foreach (var s in statusOptions)
                    {
                        <option value="@s" selected="@(Model.Status == s)" data-i18n="@("status" + s)">@MaterialStatusHelper.Label(s)</option>
                    }
                </select>
            </div>
            <div style="width:135px;">
                <label class="form-label small fw-semibold text-secondary mb-1" data-i18n="filterFromDate">Ngày nhập từ</label>
                <input type="date" name="fromDate" value="@Model.FromDate?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
            </div>
            <div style="width:135px;">
                <label class="form-label small fw-semibold text-secondary mb-1" data-i18n="filterToDate">Đến ngày</label>
                <input type="date" name="toDate" value="@Model.ToDate?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
            </div>
            <div class="form-check mb-1">
                <input type="checkbox" name="isOverdue" value="true" class="form-check-input" id="isOverdueCheck" checked="@(Model.IsOverdue == true)" />
                <label class="form-check-label small" for="isOverdueCheck" data-i18n="overdue90Days">Quá 90 ngày</label>
            </div>
            <div>
                <button type="submit" class="btn btn-sm btn-outline-dark d-inline-flex align-items-center gap-1">
                    <span class="material-icons" style="font-size:15px;">filter_alt</span> <span data-i18n="btnFilter">Lọc</span>
                </button>
            </div>
        </form>
    </div>
</div>

@if (Model.ImportSkipped is { Count: > 0 })
{
    <div class="card border-0 shadow-sm rounded-4 mb-3">
        <div class="card-body">
            <h6 class="card-title mb-3"><span data-i18n="importSkippedTitle">Dòng bị bỏ qua ở lần import gần nhất</span> (@Model.ImportSkipped.Count)</h6>
            <div class="table-responsive">
                <table class="table align-middle table-sm mb-0">
                    <thead>
                        <tr class="text-uppercase text-muted small">
                            <th>Barcode</th>
                            <th data-i18n="colReason">Lý do</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Model.ImportSkipped)
                        {
                            <tr>
                                <td class="fw-semibold">@s.Barcode</td>
                                <td>@s.Reason</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body py-2">
        <div class="table-responsive pmc-table-scroll">
            <table id="materialsTable" class="table align-middle table-sm pmc-table-compact" style="table-layout: fixed;">
                <colgroup>
                    <col data-col-key="barcode" style="width: 110px">
                    <col data-col-key="dev" style="width: 90px">
                    <col data-col-key="po" style="width: 190px">
                    <col data-col-key="supplier" style="width: 90px">
                    <col data-col-key="matlDescription" style="width: 170px">
                    <col data-col-key="colorCode" style="width: 80px">
                    <col data-col-key="colorway" style="width: 80px">
                    <col data-col-key="sizeSpec" style="width: 70px">
                    <col data-col-key="season" style="width: 80px">
                    <col data-col-key="stage" style="width: 120px">
                    <col data-col-key="component" style="width: 130px">
                    <col data-col-key="colorName" style="width: 120px">
                    <col data-col-key="focFlag" style="width: 60px">
                    <col data-col-key="csCode" style="width: 70px">
                    <col data-col-key="category" style="width: 90px">
                    <col data-col-key="matlType" style="width: 90px">
                    <col data-col-key="pic" style="width: 80px">
                    <col data-col-key="mat" style="width: 80px">
                    <col data-col-key="testing" style="width: 70px">
                    <col data-col-key="testRequire" style="width: 90px">
                    <col data-col-key="testQty" style="width: 80px">
                    <col data-col-key="requestOn" style="width: 90px">
                    <col data-col-key="remark" style="width: 150px">
                    <col data-col-key="qty" style="width: 80px">
                    <col data-col-key="balance" style="width: 80px">
                    <col data-col-key="ata" style="width: 80px">
                    <col data-col-key="status" style="width: 150px">
                    <col data-col-key="shelf" style="width: 110px">
                    <col data-col-key="stockedInAt" style="width: 100px">
                    <col data-col-key="lastIssuedAt" style="width: 100px">
                    <col data-col-key="disposedAt" style="width: 100px">
                    <col data-col-key="updatedAt" style="width: 100px">
                    @if (isAdmin)
                    {
                        <col data-col-key="action" style="width: 160px">
                    }
                </colgroup>
                <thead>
                    <tr class="text-uppercase text-muted small" style="white-space: normal;">
                        <th class="pmc-resizable-th"><span>Barcode</span><span class="col-resizer" data-col-key="barcode"></span></th>
                        <th class="pmc-resizable-th"><span>Dev</span><span class="col-resizer" data-col-key="dev"></span></th>
                        <th class="pmc-resizable-th"><span>PO</span><span class="col-resizer" data-col-key="po"></span></th>
                        <th class="pmc-resizable-th"><span data-i18n="colSupplier">Supplier</span><span class="col-resizer" data-col-key="supplier"></span></th>
                        <th class="pmc-resizable-th"><span data-i18n="colMatlDescription">Mat'l Description</span><span class="col-resizer" data-col-key="matlDescription"></span></th>
                        <th class="pmc-resizable-th"><span data-i18n="colColorCode">Color Code</span><span class="col-resizer" data-col-key="colorCode"></span></th>
                        <th class="pmc-resizable-th"><span data-i18n="colColorway">Colorway</span><span class="col-resizer" data-col-key="colorway"></span></th>
                        <th class="pmc-resizable-th"><span data-i18n="colSize">Size</span><span class="col-resizer" data-col-key="sizeSpec"></span></th>
                        <th class="pmc-resizable-th"><span data-i18n="colSeason">Season</span><span class="col-resizer" data-col-key="season"></span></th>
                        <th class="pmc-resizable-th"><span data-i18n="colStage">Stage</span><span class="col-resizer" data-col-key="stage"></span></th>
                        <th class="pmc-resizable-th"><span data-i18n="colComponent">Component</span><span class="col-resizer" data-col-key="component"></span></th>
                        <th class="pmc-resizable-th"><span data-i18n="colColorName">Color Name</span><span class="col-resizer" data-col-key="colorName"></span></th>
                        <th class="pmc-resizable-th"><span data-i18n="colFoc">FOC</span><span class="col-resizer" data-col-key="focFlag"></span></th>
                        <th class="pmc-resizable-th"><span data-i18n="colCsCode">CS Code</span><span class="col-resizer" data-col-key="csCode"></span></th>
                        <th class="pmc-resizable-th"><span data-i18n="colCategory">Category</span><span class="col-resizer" data-col-key="category"></span></th>
                        <th class="pmc-resizable-th"><span data-i18n="colMatlType">Mat'l Type</span><span class="col-resizer" data-col-key="matlType"></span></th>
                        <th class="pmc-resizable-th"><span data-i18n="colPic">PIC</span><span class="col-resizer" data-col-key="pic"></span></th>
                        <th class="pmc-resizable-th"><span data-i18n="colMat">Mat</span><span class="col-resizer" data-col-key="mat"></span></th>
                        <th class="pmc-resizable-th"><span data-i18n="colTesting">Testing</span><span class="col-resizer" data-col-key="testing"></span></th>
                        <th class="pmc-resizable-th"><span data-i18n="colTestRequire">Test Require</span><span class="col-resizer" data-col-key="testRequire"></span></th>
                        <th class="pmc-resizable-th"><span data-i18n="colTestQty">Test Qty</span><span class="col-resizer" data-col-key="testQty"></span></th>
                        <th class="pmc-resizable-th"><span data-i18n="colRequestOn">Request On</span><span class="col-resizer" data-col-key="requestOn"></span></th>
                        <th class="pmc-resizable-th"><span data-i18n="colRemark">Remark</span><span class="col-resizer" data-col-key="remark"></span></th>
                        <th class="pmc-resizable-th"><span>Qty</span><span class="col-resizer" data-col-key="qty"></span></th>
                        <th class="pmc-resizable-th"><span>Balance</span><span class="col-resizer" data-col-key="balance"></span></th>
                        <th class="pmc-resizable-th"><span>ATA</span><span class="col-resizer" data-col-key="ata"></span></th>
                        <th class="pmc-resizable-th"><span data-i18n="colStatus">Trạng thái</span><span class="col-resizer" data-col-key="status"></span></th>
                        <th class="pmc-resizable-th"><span data-i18n="colCurrentShelf">Kệ hiện tại</span><span class="col-resizer" data-col-key="shelf"></span></th>
                        <th class="pmc-resizable-th"><span data-i18n="colStockedInAt">Ngày lên kệ</span><span class="col-resizer" data-col-key="stockedInAt"></span></th>
                        <th class="pmc-resizable-th"><span data-i18n="colLastIssuedAt">Xuất gần nhất</span><span class="col-resizer" data-col-key="lastIssuedAt"></span></th>
                        <th class="pmc-resizable-th"><span data-i18n="colDisposedAt">Ngày hủy</span><span class="col-resizer" data-col-key="disposedAt"></span></th>
                        <th class="pmc-resizable-th"><span data-i18n="colUpdatedAt">Cập nhật gần nhất</span><span class="col-resizer" data-col-key="updatedAt"></span></th>
                        @if (isAdmin)
                        {
                            <th class="pmc-resizable-th"><span data-i18n="colAction">Hành động</span><span class="col-resizer" data-col-key="action"></span></th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in Model.Items)
                    {
                        var (badgeTextClass, badgeStyle) = MaterialStatusHelper.BadgeStyle(m.Status);
                        // Màu Balance so với Qty (A.Q'TY): còn đủ = xanh, đã xuất bớt (còn hàng) = vàng, hết sạch = đỏ.
                        var balanceStyle = m.Balance == null || m.ArrivalQty == null
                            ? "color:#6c757d;"
                            : m.Balance == 0
                                ? "background-color:rgba(220,53,69,0.14); color:#dc3545;"
                                : m.Balance < m.ArrivalQty
                                    ? "background-color:rgba(255,193,7,0.2); color:#b8860b;"
                                    : "background-color:rgba(25,135,84,0.14); color:#198754;";
                        <tr class="js-detail-row" data-material-id="@m.MaterialId" data-barcode="@m.Barcode" title="Double-click để xem chi tiết">
                            <td class="fw-semibold">@m.Barcode</td>
                            <td class="text-truncate" style="max-width: 0;" data-bs-toggle="tooltip" data-bs-placement="top" title="@m.Dev">@m.Dev</td>
                            <td class="text-truncate" style="max-width: 0;" data-bs-toggle="tooltip" data-bs-placement="top" title="@m.PoNo">@m.PoNo</td>
                            <td class="text-truncate" style="max-width: 0;" data-bs-toggle="tooltip" data-bs-placement="top" title="@m.Supplier">@m.Supplier</td>
                            <td>
                                <div style="overflow-x: auto; white-space: nowrap;" data-bs-toggle="tooltip" data-bs-placement="top" title="@m.MatlDescription">@m.MatlDescription</div>
                            </td>
                            <td class="text-truncate" style="max-width: 0;" data-bs-toggle="tooltip" data-bs-placement="top" title="@m.ColorCode">@m.ColorCode</td>
                            <td class="text-truncate" style="max-width: 0;" data-bs-toggle="tooltip" data-bs-placement="top" title="@m.Colorway">@m.Colorway</td>
                            <td class="text-truncate" style="max-width: 0;" data-bs-toggle="tooltip" data-bs-placement="top" title="@m.SizeSpec">@m.SizeSpec</td>
                            <td class="text-truncate" style="max-width: 0;" data-bs-toggle="tooltip" data-bs-placement="top" title="@m.Season">@m.Season</td>
                            <td class="text-truncate" style="max-width: 0;" data-bs-toggle="tooltip" data-bs-placement="top" title="@m.Stage">@m.Stage</td>
                            <td class="text-truncate" style="max-width: 0;" data-bs-toggle="tooltip" data-bs-placement="top" title="@m.Component">@m.Component</td>
                            <td class="text-truncate" style="max-width: 0;" data-bs-toggle="tooltip" data-bs-placement="top" title="@m.ColorName">@m.ColorName</td>
                            <td class="text-truncate" style="max-width: 0;" data-bs-toggle="tooltip" data-bs-placement="top" title="@m.FocFlag">@m.FocFlag</td>
                            <td class="text-truncate" style="max-width: 0;">@(m.CsCode?.ToString() ?? "—")</td>
                            <td class="text-truncate" style="max-width: 0;" data-bs-toggle="tooltip" data-bs-placement="top" title="@m.Category">@m.Category</td>
                            <td class="text-truncate" style="max-width: 0;" data-bs-toggle="tooltip" data-bs-placement="top" title="@m.MatlType">@m.MatlType</td>
                            <td class="text-truncate" style="max-width: 0;" data-bs-toggle="tooltip" data-bs-placement="top" title="@m.Pic">@m.Pic</td>
                            <td class="text-truncate" style="max-width: 0;" data-bs-toggle="tooltip" data-bs-placement="top" title="@m.Mat">@m.Mat</td>
                            <td class="text-truncate" style="max-width: 0;" data-i18n="@(m.Testing == 1 ? "yesOption" : m.Testing == 0 ? "noOption" : null)">@(m.Testing == 1 ? "Có" : m.Testing == 0 ? "Không" : "—")</td>
                            <td class="text-truncate" style="max-width: 0;" data-bs-toggle="tooltip" data-bs-placement="top" title="@m.TestRequire">@m.TestRequire</td>
                            <td class="text-truncate" style="max-width: 0;" data-bs-toggle="tooltip" data-bs-placement="top" title="@m.TestQty">@m.TestQty</td>
                            <td class="text-muted small">@(m.RequestOn?.ToString("dd/MM/yyyy") ?? "—")</td>
                            <td>
                                <div style="overflow-x: auto; white-space: nowrap;" data-bs-toggle="tooltip" data-bs-placement="top" title="@m.Remark">@m.Remark</div>
                            </td>
                            <td class="text-end">@m.ArrivalQty @m.Unit</td>
                            <td class="text-end">
                                <span class="badge" style="@balanceStyle font-weight:700;">@m.Balance @m.Unit</span>
                            </td>
                            <td class="text-muted small">@(m.ArrivalDate?.ToString("dd/MM/yyyy") ?? "—")</td>
                            <td>
                                <div class="d-flex flex-column align-items-start gap-1">
                                    <span class="badge @badgeTextClass" style="@badgeStyle" data-i18n="@("status" + m.Status)">@MaterialStatusHelper.Label(m.Status)</span>
                                    @if (m.IsOverdue)
                                    {
                                        <span class="badge bg-danger" data-i18n="overdue90Days">Quá 90 ngày</span>
                                    }
                                </div>
                            </td>
                            <td>
                                @if (m.LocationCode != null)
                                {
                                    <span class="badge pmc-badge-soft-blue" style="font-weight:700;">@m.LocationCode</span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td class="text-muted small">@(m.StockedInAt?.ToString("dd/MM/yyyy") ?? "—")</td>
                            <td class="text-muted small">@(m.LastIssuedAt?.ToString("dd/MM/yyyy") ?? "—")</td>
                            <td class="text-muted small">@(m.DisposedAt?.ToString("dd/MM/yyyy") ?? "—")</td>
                            <td class="text-muted small">@(m.UpdatedAt?.ToString("dd/MM/yyyy") ?? "—")</td>
                            @if (isAdmin)
                            {
                                <td class="text-end">
                                    <div class="d-flex gap-2 justify-content-end">
                                        <button type="button" class="btn btn-sm btn-outline-secondary js-view-btn" data-id="@m.MaterialId" data-barcode="@m.Barcode" title="Xem chi tiết" data-i18n-title="viewDetailTooltip">
                                            <span class="material-icons" style="font-size:16px;">visibility</span>
                                        </button>
                                        @if (m.Status != "Disposed")
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-secondary js-edit-btn" data-id="@m.MaterialId" title="Sửa thông tin" data-i18n-title="editTooltip">
                                                <span class="material-icons" style="font-size:16px;">edit</span>
                                            </button>
                                            <button type="button" class="btn btn-sm btn-outline-danger js-dispose-btn" data-id="@m.MaterialId" data-barcode="@m.Barcode" title="Hủy liệu" data-i18n-title="disposeRowTooltip">
                                                <span class="material-icons" style="font-size:16px;">delete_outline</span>
                                            </button>
                                        }
                                    </div>
                                </td>
                            }
                        </tr>
                    }
                    @if (Model.Items.Count == 0)
                    {
                        <tr>
                            <td colspan="@(isAdmin ? 33 : 32)" class="text-center text-muted py-4" data-i18n="emptyMaterials">Không có dữ liệu phù hợp.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="mt-3">
            @await Html.PartialAsync("_Pagination", Model.Pagination)
        </div>
    </div>
</div>

@if (isAdmin)
{
    <div class="modal fade" id="importModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 rounded-4 shadow">
                <div class="modal-header border-0">
                    <h5 class="modal-title" data-i18n="importModalTitle">Import liệu từ Excel</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form asp-controller="Materials" asp-action="Index" method="post" enctype="multipart/form-data">
                    <div class="modal-body">
                        <label class="form-label small fw-semibold text-secondary mb-1" data-i18n="chooseExcelFile">Chọn file Excel (.xlsx)</label>
                        <input type="file" name="file" accept=".xlsx" class="form-control" required />
                    </div>
                    <div class="modal-footer border-0">
                        <button type="button" class="btn btn-light" data-bs-dismiss="modal" data-i18n="btnCancel">Hủy</button>
                        <button type="submit" class="btn pmc-btn-dark d-inline-flex align-items-center gap-1">
                            <span class="material-icons" style="font-size:18px;">cloud_upload</span> <span data-i18n="btnImport">Import</span>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="modal fade" id="editModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-xl modal-dialog-scrollable">
            <div class="modal-content border-0 rounded-4 shadow">
                <div class="modal-header border-0">
                    <h5 class="modal-title" data-i18n="editModalTitle">Sửa thông tin liệu</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form asp-controller="Materials" asp-action="Edit" method="post" id="editForm" style="display:contents;">
                    <input type="hidden" name="MaterialId" id="edit_MaterialId" />
                    <input type="hidden" name="ReturnUrl" id="edit_ReturnUrl" />
                    <div class="modal-body">
                        <div class="row row-cols-3 g-2">
                            <div class="pmc-detail-cell"><label class="form-label small fw-semibold text-secondary mb-1" data-i18n="editArrivalQty">Số lượng (Q'ty)</label><input type="number" step="any" min="0.01" class="form-control" name="ArrivalQty" id="edit_ArrivalQty" required /></div>
                            <div class="pmc-detail-cell"><label class="form-label small fw-semibold text-secondary mb-1">Dev</label><input class="form-control" name="Dev" id="edit_Dev" /></div>
                            <div class="pmc-detail-cell"><label class="form-label small fw-semibold text-secondary mb-1">PO</label><input class="form-control" name="PoNo" id="edit_PoNo" /></div>
                            <div class="pmc-detail-cell"><label class="form-label small fw-semibold text-secondary mb-1">Supplier</label><input class="form-control" name="Supplier" id="edit_Supplier" /></div>
                            <div class="pmc-detail-cell"><label class="form-label small fw-semibold text-secondary mb-1">Model</label><input class="form-control" name="Model" id="edit_Model" /></div>
                            <div class="pmc-detail-cell"><label class="form-label small fw-semibold text-secondary mb-1">Season</label><input class="form-control" name="Season" id="edit_Season" /></div>
                            <div class="pmc-detail-cell"><label class="form-label small fw-semibold text-secondary mb-1">Stage</label><input class="form-control" name="Stage" id="edit_Stage" /></div>
                            <div class="pmc-detail-cell"><label class="form-label small fw-semibold text-secondary mb-1">Colorway</label><input class="form-control" name="Colorway" id="edit_Colorway" /></div>
                            <div class="pmc-detail-cell"><label class="form-label small fw-semibold text-secondary mb-1">Component</label><input class="form-control" name="Component" id="edit_Component" /></div>
                            <div class="col-12 pmc-detail-cell"><label class="form-label small fw-semibold text-secondary mb-1" data-i18n="editMatlDescription">Mô tả liệu</label><input class="form-control" name="MatlDescription" id="edit_MatlDescription" /></div>
                            <div class="pmc-detail-cell"><label class="form-label small fw-semibold text-secondary mb-1">Color code</label><input class="form-control" name="ColorCode" id="edit_ColorCode" /></div>
                            <div class="pmc-detail-cell"><label class="form-label small fw-semibold text-secondary mb-1">Color name</label><input class="form-control" name="ColorName" id="edit_ColorName" /></div>
                            <div class="pmc-detail-cell"><label class="form-label small fw-semibold text-secondary mb-1">Size</label><input class="form-control" name="SizeSpec" id="edit_SizeSpec" /></div>
                            <div class="pmc-detail-cell"><label class="form-label small fw-semibold text-secondary mb-1" data-i18n="editUnit">Đơn vị</label><input class="form-control" name="Unit" id="edit_Unit" /></div>
                            <div class="pmc-detail-cell"><label class="form-label small fw-semibold text-secondary mb-1">FOC</label><input class="form-control" name="FocFlag" id="edit_FocFlag" /></div>
                            <div class="pmc-detail-cell"><label class="form-label small fw-semibold text-secondary mb-1" data-i18n="editArrivalDate">Ngày nhập (ATA)</label><input type="date" class="form-control" name="ArrivalDate" id="edit_ArrivalDate" /></div>
                            <div class="pmc-detail-cell">
                                <label class="form-label small fw-semibold text-secondary mb-1">Testing</label>
                                <select class="form-select" name="Testing" id="edit_Testing">
                                    <option value="">—</option>
                                    <option value="1" data-i18n="yesOption">Có</option>
                                    <option value="0" data-i18n="noOption">Không</option>
                                </select>
                            </div>
                            <div class="pmc-detail-cell"><label class="form-label small fw-semibold text-secondary mb-1">Test require</label><input class="form-control" name="TestRequire" id="edit_TestRequire" /></div>
                            <div class="pmc-detail-cell"><label class="form-label small fw-semibold text-secondary mb-1">Test qty</label><input class="form-control" name="TestQty" id="edit_TestQty" /></div>
                            <div class="pmc-detail-cell"><label class="form-label small fw-semibold text-secondary mb-1">Category</label><input class="form-control" name="Category" id="edit_Category" /></div>
                            <div class="pmc-detail-cell"><label class="form-label small fw-semibold text-secondary mb-1">Request on</label><input type="date" class="form-control" name="RequestOn" id="edit_RequestOn" /></div>
                            <div class="pmc-detail-cell"><label class="form-label small fw-semibold text-secondary mb-1">Mat'l Type</label><input class="form-control" name="MatlType" id="edit_MatlType" /></div>
                            <div class="pmc-detail-cell"><label class="form-label small fw-semibold text-secondary mb-1">PIC</label><input class="form-control" name="Pic" id="edit_Pic" /></div>
                            <div class="pmc-detail-cell"><label class="form-label small fw-semibold text-secondary mb-1">Mat</label><input class="form-control" name="Mat" id="edit_Mat" /></div>
                            <div class="col-12 pmc-detail-cell"><label class="form-label small fw-semibold text-secondary mb-1">Remark</label><textarea class="form-control" name="Remark" id="edit_Remark" rows="2"></textarea></div>
                        </div>
                    </div>
                </form>
                <form asp-controller="Materials" asp-action="Delete" method="post" id="deleteForm">
                    <input type="hidden" name="materialId" id="delete_MaterialId" />
                    <input type="hidden" name="returnUrl" id="delete_ReturnUrl" />
                </form>
                <form asp-controller="Materials" asp-action="Dispose" method="post" id="disposeForm">
                    <input type="hidden" name="materialId" id="dispose_MaterialId" />
                    <input type="hidden" name="barcode" id="dispose_Barcode" />
                    <input type="hidden" name="returnUrl" id="dispose_ReturnUrl" />
                </form>
                <div class="modal-footer border-0 d-flex justify-content-between">
                    <button type="submit" form="deleteForm" class="btn btn-outline-danger d-inline-flex align-items-center gap-1">
                        <span class="material-icons" style="font-size:18px;">delete</span> <span data-i18n="btnDelete">Xóa</span>
                    </button>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-light" data-bs-dismiss="modal" data-i18n="btnCancel">Hủy</button>
                        <button type="submit" form="editForm" class="btn pmc-btn-dark d-inline-flex align-items-center gap-1">
                            <span class="material-icons" style="font-size:18px;">save</span> <span data-i18n="btnSave">Lưu</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

}

<div id="pmc-flash"
     data-success="@(ViewData["FlashSuccess"] as string)"
     data-warning="@(ViewData["FlashWarning"] as string)"
     data-error="@(ViewData["FlashError"] as string)"
     style="display:none"></div>

@section Scripts {
    <script>
        (function () {
            var flash = document.getElementById('pmc-flash');
            if (flash.dataset.success) PmcUI.success(PmcWhI18n.renderFlash(flash.dataset.success));
            if (flash.dataset.warning) PmcUI.warning(PmcWhI18n.renderFlash(flash.dataset.warning));
            if (flash.dataset.error) PmcUI.error(PmcWhI18n.renderFlash(flash.dataset.error));

            // Bảng quá dày (mỗi dòng ~27px) nên tooltip mặc định của trình duyệt (bám theo vị trí
            // con trỏ chuột) hay đè lên chữ của dòng kế bên — chuyển qua Bootstrap Tooltip, ép hiện
            // phía TRÊN ô đang trỏ vào (data-bs-placement="top") để không che dòng dưới.
            document.querySelectorAll('#materialsTable [data-bs-toggle="tooltip"]').forEach(function (el) {
                if (el.getAttribute('title')) {
                    new bootstrap.Tooltip(el);
                }
            });

            var editModalEl = document.getElementById('editModal');
            if (editModalEl) {
                var editModal = new bootstrap.Modal(editModalEl);
                var editForm = document.getElementById('editForm');

                var deleteForm = document.getElementById('deleteForm');

                document.querySelectorAll('.js-edit-btn').forEach(function (btn) {
                    btn.addEventListener('click', async function (e) {
                        e.stopPropagation();
                        var id = btn.dataset.id;
                        var row = btn.closest('tr');
                        try {
                            var detail = await PmcUI.withLoading(() =>
                                fetch('Materials/' + id + '/EditData').then(function (r) {
                                    if (!r.ok) throw new Error('Không tải được thông tin liệu.');
                                    return r.json();
                                })
                            );
                            document.getElementById('edit_MaterialId').value = id;
                            document.getElementById('edit_ReturnUrl').value = window.location.pathname + window.location.search;
                            document.getElementById('delete_MaterialId').value = id;
                            document.getElementById('delete_ReturnUrl').value = window.location.pathname + window.location.search;
                            if (deleteForm) deleteForm.dataset.barcode = row ? (row.dataset.barcode || '') : '';
                            // API trả JSON camelCase (dev, poNo, ...) — map sang id PascalCase (edit_Dev, edit_PoNo, ...).
                            ['arrivalQty', 'dev', 'poNo', 'supplier', 'model', 'season', 'stage', 'colorway', 'component',
                             'matlDescription', 'colorCode', 'colorName', 'sizeSpec', 'unit', 'focFlag',
                             'remark', 'testRequire', 'testQty', 'category',
                             'matlType', 'pic', 'mat'].forEach(function (field) {
                                var elId = 'edit_' + field.charAt(0).toUpperCase() + field.slice(1);
                                document.getElementById(elId).value = detail[field] || '';
                            });
                            document.getElementById('edit_Testing').value = detail.testing === null || detail.testing === undefined ? '' : detail.testing;
                            document.getElementById('edit_ArrivalDate').value = detail.arrivalDate ? detail.arrivalDate.substring(0, 10) : '';
                            document.getElementById('edit_RequestOn').value = detail.requestOn ? detail.requestOn.substring(0, 10) : '';
                            editModal.show();
                        } catch (err) {
                            PmcUI.error(PmcWhI18n.t('loadMaterialInfoError'));
                        }
                    });
                });

                editForm.addEventListener('submit', function () {
                    var saveBtn = document.querySelector('button[form="editForm"]');
                    if (saveBtn) saveBtn.disabled = true;
                });

                if (deleteForm) {
                    deleteForm.addEventListener('submit', async function (e) {
                        e.preventDefault();
                        var barcode = deleteForm.dataset.barcode || '';
                        var ok = await PmcUI.confirmDelete(PmcWhI18n.t('confirmDeleteMaterialMsg').replace('{barcode}', barcode));
                        if (ok) {
                            document.querySelector('button[form="deleteForm"]').disabled = true;
                            deleteForm.submit();
                        }
                    });
                }

                document.querySelectorAll('.js-view-btn').forEach(function (btn) {
                    btn.addEventListener('click', function (e) {
                        e.stopPropagation();
                        PmcMaterialDetail.show(btn.dataset.id, btn.dataset.barcode);
                    });
                });

                // Nút "Huỷ" ngay trên dòng — khác Xoá (ẩn khỏi hệ thống): chuyển Status='Disposed',
                // Balance về 0, vẫn còn trong danh sách 30 ngày ở màn Hủy liệu. Dùng chung 1 <form>
                // ẩn (disposeForm) cho mọi dòng, không cần mở modal như nút Sửa.
                var disposeForm = document.getElementById('disposeForm');
                if (disposeForm) {
                    document.querySelectorAll('.js-dispose-btn').forEach(function (btn) {
                        btn.addEventListener('click', async function (e) {
                            e.stopPropagation();
                            var barcode = btn.dataset.barcode || '';
                            var ok = await PmcUI.confirmDelete(PmcWhI18n.t('confirmDisposeMsg').replace('{barcode}', barcode));
                            if (!ok) return;
                            document.getElementById('dispose_MaterialId').value = btn.dataset.id;
                            document.getElementById('dispose_Barcode').value = barcode;
                            document.getElementById('dispose_ReturnUrl').value = window.location.pathname + window.location.search;
                            btn.disabled = true;
                            disposeForm.submit();
                        });
                    });
                }
            }

            // Draggable column resize (Materials/Index) — widths persist per-browser via localStorage.
            (function () {
                var STORAGE_KEY = 'pmc_materials_col_widths_v1';
                var table = document.getElementById('materialsTable');
                if (!table) return;

                function colFor(key) {
                    return table.querySelector('col[data-col-key="' + key + '"]');
                }

                var saved = {};
                try { saved = JSON.parse(localStorage.getItem(STORAGE_KEY)) || {}; } catch (e) { saved = {}; }
                Object.keys(saved).forEach(function (key) {
                    var col = colFor(key);
                    if (col && saved[key] > 0) col.style.width = saved[key] + 'px';
                });

                function saveWidths() {
                    var widths = {};
                    table.querySelectorAll('col[data-col-key]').forEach(function (col) {
                        widths[col.dataset.colKey] = col.getBoundingClientRect().width;
                    });
                    localStorage.setItem(STORAGE_KEY, JSON.stringify(widths));
                }

                table.querySelectorAll('.col-resizer').forEach(function (resizer) {
                    resizer.addEventListener('mousedown', function (e) {
                        e.preventDefault();
                        var col = colFor(resizer.dataset.colKey);
                        if (!col) return;
                        var startX = e.clientX;
                        var startWidth = col.getBoundingClientRect().width;
                        resizer.classList.add('is-resizing');
                        document.body.classList.add('pmc-col-resizing');

                        function onMove(ev) {
                            var newWidth = Math.max(40, startWidth + (ev.clientX - startX));
                            col.style.width = newWidth + 'px';
                        }
                        function onUp() {
                            document.removeEventListener('mousemove', onMove);
                            document.removeEventListener('mouseup', onUp);
                            resizer.classList.remove('is-resizing');
                            document.body.classList.remove('pmc-col-resizing');
                            saveWidths();
                        }
                        document.addEventListener('mousemove', onMove);
                        document.addEventListener('mouseup', onUp);
                    });
                });
            })();
        })();
    </script>
}
