@using PmcWh.Web.Helpers
@model PmcWh.Web.Models.MaterialListViewModel
@{
    ViewData["Title"] = "Cơ sở dữ liệu của PMC";
    var statusOptions = MaterialStatusHelper.AllStatuses;
    var isAdmin = User.IsInRole("Admin");
}

<div class="card border-0 shadow-sm rounded-4 mb-3">
    <div class="card-body">
        <div class="d-flex align-items-center justify-content-between gap-3 mb-4 flex-wrap">
            <div class="d-flex align-items-center gap-3">
                <span class="d-inline-flex align-items-center justify-content-center rounded-4"
                      style="width:48px;height:48px;background:linear-gradient(135deg, #495057 0%, #212529 100%); flex-shrink:0;">
                    <span class="material-icons text-white">storage</span>
                </span>
                <div>
                    <h5 class="card-title mb-0">Cơ sở dữ liệu của PMC</h5>
                    <p class="text-muted small mb-0">Toàn bộ liệu đã nhập vào hệ thống</p>
                </div>
            </div>
            <a asp-controller="Materials" asp-action="ExportExcel"
               asp-route-barcode="@Model.Barcode" asp-route-status="@Model.Status"
               asp-route-fromDate="@Model.FromDate?.ToString("yyyy-MM-dd")" asp-route-toDate="@Model.ToDate?.ToString("yyyy-MM-dd")"
               asp-route-isOverdue="@Model.IsOverdue"
               class="btn pmc-btn-dark d-inline-flex align-items-center gap-1">
                <span class="material-icons" style="font-size:18px;">file_download</span> Xuất Excel
            </a>
        </div>

        @if (isAdmin)
        {
            <div class="d-flex flex-wrap align-items-center gap-2 mb-3 pb-3 border-bottom">
                <button type="button" class="btn pmc-btn-dark d-inline-flex align-items-center gap-1" data-bs-toggle="modal" data-bs-target="#importModal">
                    <span class="material-icons" style="font-size:18px;">cloud_upload</span> Import
                </button>
                <a asp-controller="Materials" asp-action="DownloadTemplate" class="btn btn-outline-secondary d-inline-flex align-items-center gap-1">
                    <span class="material-icons" style="font-size:18px;">download</span> Tải file mẫu
                </a>
            </div>
        }

        <form asp-controller="Materials" asp-action="Index" method="get" class="row g-2 align-items-end">
            <div class="col-sm-6 col-md-3">
                <label class="form-label small fw-semibold text-secondary">Barcode</label>
                <div class="input-group">
                    <span class="input-group-text bg-white"><span class="material-icons" style="font-size:18px;">search</span></span>
                    <input type="text" name="barcode" value="@Model.Barcode" class="form-control" placeholder="Tìm theo barcode..." />
                </div>
            </div>
            <div class="col-sm-4 col-md-2">
                <label class="form-label small fw-semibold text-secondary">Trạng thái</label>
                <select name="status" class="form-select">
                    <option value="">Tất cả</option>
                    @foreach (var s in statusOptions)
                    {
                        <option value="@s" selected="@(Model.Status == s)">@MaterialStatusHelper.Label(s)</option>
                    }
                </select>
            </div>
            <div class="col-sm-4 col-md-2">
                <label class="form-label small fw-semibold text-secondary">Ngày nhập từ</label>
                <input type="date" name="fromDate" value="@Model.FromDate?.ToString("yyyy-MM-dd")" class="form-control" />
            </div>
            <div class="col-sm-4 col-md-2">
                <label class="form-label small fw-semibold text-secondary">Đến ngày</label>
                <input type="date" name="toDate" value="@Model.ToDate?.ToString("yyyy-MM-dd")" class="form-control" />
            </div>
            <div class="col-sm-4 col-md-1 d-flex align-items-center">
                <div class="form-check">
                    <input type="checkbox" name="isOverdue" value="true" class="form-check-input" id="isOverdueCheck" checked="@(Model.IsOverdue == true)" />
                    <label class="form-check-label small" for="isOverdueCheck">Quá 90 ngày</label>
                </div>
            </div>
            <div class="col-sm-4 col-md-2">
                <button type="submit" class="btn btn-outline-dark w-100 d-inline-flex align-items-center justify-content-center gap-1">
                    <span class="material-icons" style="font-size:18px;">filter_alt</span> Lọc
                </button>
            </div>
        </form>
    </div>
</div>

@if (Model.ImportSkipped is { Count: > 0 })
{
    <div class="card border-0 shadow-sm rounded-4 mb-3">
        <div class="card-body">
            <h6 class="card-title mb-3">Dòng bị bỏ qua ở lần import gần nhất (@Model.ImportSkipped.Count)</h6>
            <div class="table-responsive">
                <table class="table align-middle table-sm mb-0">
                    <thead>
                        <tr class="text-uppercase text-muted small">
                            <th>Barcode</th>
                            <th>Lý do</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Model.ImportSkipped)
                        {
                            <tr>
                                <td class="fw-semibold">@s.Barcode</td>
                                <td>@s.Reason</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table align-middle" style="table-layout: fixed; width: 100%;">
                <colgroup>
                    <col style="width: 11%">
                    <col style="width: 9%">
                    <col style="width: 9%">
                    <col style="width: 10%">
                    <col style="width: 19%">
                    <col style="width: 9%">
                    <col style="width: 6%">
                    <col style="width: 7%">
                    <col style="width: 9%">
                    <col style="width: 6%">
                    @if (isAdmin)
                    {
                        <col style="width: 5%">
                    }
                </colgroup>
                <thead>
                    <tr class="text-uppercase text-muted small">
                        <th>Barcode</th>
                        <th>Dev</th>
                        <th>PO</th>
                        <th>Supplier</th>
                        <th>Mat'l Description</th>
                        <th>Color Code</th>
                        <th class="text-end">A.Q'TY</th>
                        <th>ATA</th>
                        <th>Trạng thái</th>
                        <th>Kệ hiện tại</th>
                        @if (isAdmin)
                        {
                            <th class="text-end">Hành động</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in Model.Items)
                    {
                        var (badgeTextClass, badgeStyle) = MaterialStatusHelper.BadgeStyle(m.Status);
                        <tr class="js-material-row" style="cursor:pointer;" data-id="@m.MaterialId" data-barcode="@m.Barcode" title="Double-click để xem chi tiết">
                            <td class="fw-semibold">
                                @m.Barcode
                                <div class="text-muted small fw-normal">@m.CreatedAt.ToString("dd/MM/yyyy")</div>
                            </td>
                            <td class="text-truncate" style="max-width: 0;" title="@m.Dev">@m.Dev</td>
                            <td class="text-truncate" style="max-width: 0;" title="@m.PoNo">@m.PoNo</td>
                            <td class="text-truncate" style="max-width: 0;" title="@m.Supplier">@m.Supplier</td>
                            <td>
                                <div style="overflow-x: auto; white-space: nowrap;" title="@m.MatlDescription">@m.MatlDescription</div>
                            </td>
                            <td class="text-truncate" style="max-width: 0;" title="@m.ColorCode">@m.ColorCode</td>
                            <td class="text-end">@m.ArrivalQty @m.Unit</td>
                            <td class="text-muted small">@(m.ArrivalDate?.ToString("dd/MM/yyyy") ?? "—")</td>
                            <td>
                                <span class="badge @badgeTextClass" style="@badgeStyle">@MaterialStatusHelper.Label(m.Status)</span>
                                @if (m.IsOverdue)
                                {
                                    <span class="badge bg-danger ms-1">Quá 90 ngày</span>
                                }
                            </td>
                            <td>@(m.LocationCode ?? "—")</td>
                            @if (isAdmin)
                            {
                                <td class="text-end">
                                    <button type="button" class="btn btn-sm btn-outline-secondary js-edit-btn" data-id="@m.MaterialId" title="Sửa thông tin">
                                        <span class="material-icons" style="font-size:16px;">edit</span>
                                    </button>
                                    @if (m.IsOverdue)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-danger js-archive-btn ms-1"
                                                data-id="@m.MaterialId" data-barcode="@m.Barcode" title="Xóa liệu quá hạn">
                                            <span class="material-icons" style="font-size:16px;">delete_forever</span>
                                        </button>
                                    }
                                </td>
                            }
                        </tr>
                    }
                    @if (Model.Items.Count == 0)
                    {
                        <tr>
                            <td colspan="@(isAdmin ? 11 : 10)" class="text-center text-muted py-4">Không có dữ liệu phù hợp.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="mt-3">
            @await Html.PartialAsync("_Pagination", Model.Pagination)
        </div>
    </div>
</div>

@if (isAdmin)
{
    <div class="modal fade" id="importModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 rounded-4 shadow">
                <div class="modal-header border-0">
                    <h5 class="modal-title">Import liệu từ Excel</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form asp-controller="Materials" asp-action="Index" method="post" enctype="multipart/form-data">
                    <div class="modal-body">
                        <label class="form-label small fw-semibold text-secondary">Chọn file Excel (.xlsx)</label>
                        <input type="file" name="file" accept=".xlsx" class="form-control" required />
                    </div>
                    <div class="modal-footer border-0">
                        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Hủy</button>
                        <button type="submit" class="btn pmc-btn-dark d-inline-flex align-items-center gap-1">
                            <span class="material-icons" style="font-size:18px;">cloud_upload</span> Import
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="modal fade" id="editModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content border-0 rounded-4 shadow">
                <div class="modal-header border-0">
                    <h5 class="modal-title">Sửa thông tin liệu</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form asp-controller="Materials" asp-action="Edit" method="post" id="editForm">
                    <input type="hidden" name="MaterialId" id="edit_MaterialId" />
                    <input type="hidden" name="ReturnUrl" id="edit_ReturnUrl" />
                    <div class="modal-body">
                        <div class="row row-cols-2 g-3">
                            <div><label class="form-label small fw-semibold text-secondary">Số lượng (A.Q'TY)</label><input type="number" step="any" min="0.01" class="form-control" name="ArrivalQty" id="edit_ArrivalQty" required /></div>
                            <div><label class="form-label small fw-semibold text-secondary">Dev</label><input class="form-control" name="Dev" id="edit_Dev" /></div>
                            <div><label class="form-label small fw-semibold text-secondary">PO</label><input class="form-control" name="PoNo" id="edit_PoNo" /></div>
                            <div><label class="form-label small fw-semibold text-secondary">Supplier</label><input class="form-control" name="Supplier" id="edit_Supplier" /></div>
                            <div><label class="form-label small fw-semibold text-secondary">Model</label><input class="form-control" name="Model" id="edit_Model" /></div>
                            <div><label class="form-label small fw-semibold text-secondary">Season</label><input class="form-control" name="Season" id="edit_Season" /></div>
                            <div><label class="form-label small fw-semibold text-secondary">Stage</label><input class="form-control" name="Stage" id="edit_Stage" /></div>
                            <div><label class="form-label small fw-semibold text-secondary">Colorway</label><input class="form-control" name="Colorway" id="edit_Colorway" /></div>
                            <div><label class="form-label small fw-semibold text-secondary">Component</label><input class="form-control" name="Component" id="edit_Component" /></div>
                            <div class="col-12"><label class="form-label small fw-semibold text-secondary">Mô tả liệu</label><input class="form-control" name="MatlDescription" id="edit_MatlDescription" /></div>
                            <div><label class="form-label small fw-semibold text-secondary">Color code</label><input class="form-control" name="ColorCode" id="edit_ColorCode" /></div>
                            <div><label class="form-label small fw-semibold text-secondary">Color name</label><input class="form-control" name="ColorName" id="edit_ColorName" /></div>
                            <div><label class="form-label small fw-semibold text-secondary">Size</label><input class="form-control" name="SizeSpec" id="edit_SizeSpec" /></div>
                            <div><label class="form-label small fw-semibold text-secondary">Đơn vị</label><input class="form-control" name="Unit" id="edit_Unit" /></div>
                            <div><label class="form-label small fw-semibold text-secondary">FOC</label><input class="form-control" name="FocFlag" id="edit_FocFlag" /></div>
                            <div><label class="form-label small fw-semibold text-secondary">Ngày nhập (ATA)</label><input type="date" class="form-control" name="ArrivalDate" id="edit_ArrivalDate" /></div>
                            <div>
                                <label class="form-label small fw-semibold text-secondary">Testing</label>
                                <select class="form-select" name="Testing" id="edit_Testing">
                                    <option value="">—</option>
                                    <option value="1">Có</option>
                                    <option value="0">Không</option>
                                </select>
                            </div>
                            <div><label class="form-label small fw-semibold text-secondary">Test require</label><input class="form-control" name="TestRequire" id="edit_TestRequire" /></div>
                            <div><label class="form-label small fw-semibold text-secondary">Test qty</label><input class="form-control" name="TestQty" id="edit_TestQty" /></div>
                            <div><label class="form-label small fw-semibold text-secondary">Category</label><input class="form-control" name="Category" id="edit_Category" /></div>
                            <div><label class="form-label small fw-semibold text-secondary">Request on</label><input type="date" class="form-control" name="RequestOn" id="edit_RequestOn" /></div>
                            <div><label class="form-label small fw-semibold text-secondary">Mat'l Type</label><input class="form-control" name="MatlType" id="edit_MatlType" /></div>
                            <div><label class="form-label small fw-semibold text-secondary">PIC</label><input class="form-control" name="Pic" id="edit_Pic" /></div>
                            <div><label class="form-label small fw-semibold text-secondary">Mat</label><input class="form-control" name="Mat" id="edit_Mat" /></div>
                            <div class="col-12"><label class="form-label small fw-semibold text-secondary">Remark</label><textarea class="form-control" name="Remark" id="edit_Remark" rows="2"></textarea></div>
                        </div>
                    </div>
                    <div class="modal-footer border-0">
                        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Hủy</button>
                        <button type="submit" class="btn pmc-btn-dark d-inline-flex align-items-center gap-1">
                            <span class="material-icons" style="font-size:18px;">save</span> Lưu
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <form asp-controller="Materials" asp-action="ArchiveOverdue" method="post" id="archiveForm">
        <input type="hidden" name="id" id="archive_id" />
        <input type="hidden" name="returnUrl" id="archive_returnUrl" />
    </form>
}

<div id="pmc-flash"
     data-success="@(ViewData["FlashSuccess"] as string)"
     data-warning="@(ViewData["FlashWarning"] as string)"
     data-error="@(ViewData["FlashError"] as string)"
     style="display:none"></div>

@section Scripts {
    <script>
        (function () {
            var flash = document.getElementById('pmc-flash');
            if (flash.dataset.success) PmcUI.success(flash.dataset.success);
            if (flash.dataset.warning) PmcUI.warning(flash.dataset.warning);
            if (flash.dataset.error) PmcUI.error(flash.dataset.error);

            document.querySelectorAll('.js-material-row').forEach(function (row) {
                row.addEventListener('dblclick', async function () {
                    var id = row.dataset.id;
                    var barcode = row.dataset.barcode;
                    try {
                        var html = await PmcUI.withLoading(() =>
                            fetch('/Materials/' + id + '/Detail').then(function (r) {
                                if (!r.ok) throw new Error('Không tải được chi tiết.');
                                return r.text();
                            })
                        );
                        PmcUI.popup('Chi tiết liệu — ' + barcode, html, { size: 'lg' });
                    } catch (e) {
                        PmcUI.error('Không tải được chi tiết liệu.');
                    }
                });
            });

            var editModalEl = document.getElementById('editModal');
            if (editModalEl) {
                var editModal = new bootstrap.Modal(editModalEl);
                var editForm = document.getElementById('editForm');

                document.querySelectorAll('.js-edit-btn').forEach(function (btn) {
                    btn.addEventListener('click', async function (e) {
                        e.stopPropagation();
                        var id = btn.dataset.id;
                        try {
                            var detail = await PmcUI.withLoading(() =>
                                fetch('/Materials/' + id + '/EditData').then(function (r) {
                                    if (!r.ok) throw new Error('Không tải được thông tin liệu.');
                                    return r.json();
                                })
                            );
                            document.getElementById('edit_MaterialId').value = id;
                            document.getElementById('edit_ReturnUrl').value = window.location.pathname + window.location.search;
                            // API trả JSON camelCase (dev, poNo, ...) — map sang id PascalCase (edit_Dev, edit_PoNo, ...).
                            ['arrivalQty', 'dev', 'poNo', 'supplier', 'model', 'season', 'stage', 'colorway', 'component',
                             'matlDescription', 'colorCode', 'colorName', 'sizeSpec', 'unit', 'focFlag',
                             'remark', 'testRequire', 'testQty', 'category',
                             'matlType', 'pic', 'mat'].forEach(function (field) {
                                var elId = 'edit_' + field.charAt(0).toUpperCase() + field.slice(1);
                                document.getElementById(elId).value = detail[field] || '';
                            });
                            document.getElementById('edit_Testing').value = detail.testing === null || detail.testing === undefined ? '' : detail.testing;
                            document.getElementById('edit_ArrivalDate').value = detail.arrivalDate ? detail.arrivalDate.substring(0, 10) : '';
                            document.getElementById('edit_RequestOn').value = detail.requestOn ? detail.requestOn.substring(0, 10) : '';
                            editModal.show();
                        } catch (err) {
                            PmcUI.error('Không tải được thông tin liệu.');
                        }
                    });
                });

                editForm.addEventListener('submit', function () {
                    editForm.querySelector('button[type="submit"]').disabled = true;
                });
            }

            document.querySelectorAll('.js-archive-btn').forEach(function (btn) {
                btn.addEventListener('click', async function (e) {
                    e.stopPropagation();
                    var barcode = btn.dataset.barcode;
                    var ok = await PmcUI.confirmDelete('Xóa liệu quá hạn "' + barcode + '" khỏi danh sách? Lịch sử vẫn được giữ lại.');
                    if (ok) {
                        document.getElementById('archive_id').value = btn.dataset.id;
                        document.getElementById('archive_returnUrl').value = window.location.pathname + window.location.search;
                        document.getElementById('archiveForm').submit();
                    }
                });
            });
        })();
    </script>
}
