@using PmcWh.Web.Helpers
@model PmcWh.Web.Models.MaterialDetail
@{
    string Fmt(DateTime? d) => d?.ToString("dd/MM/yyyy") ?? "—";
    string FmtDT(DateTime d) => d.ToString("dd/MM/yyyy HH:mm");
    string Val(string? s) => string.IsNullOrWhiteSpace(s) ? "—" : s;
    var (badgeTextClass, badgeStyle) = MaterialStatusHelper.BadgeStyle(Model.Status);
    // Màu Balance so với Qty (A.Q'TY) — giống hệt cách tô màu ở bảng Cơ sở dữ liệu (Materials/Index):
    // còn đủ = xanh, đã xuất bớt (còn hàng) = vàng, hết sạch = đỏ.
    var balanceStyle = Model.Balance == null || Model.ArrivalQty == null
        ? "color:#6c757d;"
        : Model.Balance == 0
            ? "background-color:rgba(220,53,69,0.14); color:#dc3545;"
            : Model.Balance < Model.ArrivalQty
                ? "background-color:rgba(255,193,7,0.2); color:#b8860b;"
                : "background-color:rgba(25,135,84,0.14); color:#198754;";

    string MovementLabel(string type) => type switch
    {
        "Inbound" => "Lên kệ",
        "IssueToWorkshop" => "Xuất",
        "Return" => "Nhận lại",
        "Dispose" => "Hủy",
        _ => type,
    };
}

@* Barcode không lặp lại ở đây nữa — modal title (PmcMaterialDetail.show) đã có sẵn "Chi tiết liệu
   — {barcode}" rồi, chỉ còn giữ badge trạng thái + nút Copy. *@
<div class="d-flex align-items-center justify-content-between mb-2 pmc-detail-header">
    <span class="badge @badgeTextClass" style="@badgeStyle" data-i18n="@("status" + Model.Status)">@MaterialStatusHelper.Label(Model.Status)</span>
    <button type="button" class="btn btn-sm btn-outline-secondary js-copy-detail d-inline-flex align-items-center gap-1" title="Copy để gửi chat" data-i18n-title="copyDetailTooltip">
        <span class="material-icons" style="font-size:15px;">content_copy</span> <span data-i18n="btnCopy">Copy</span>
    </button>
</div>

@{
    // Show đủ hết mọi field, kể cả field chưa có data (PMC cần biết field nào chưa nhập) — chỉ
    // gọn hoá bằng cách giảm cỡ chữ/khoảng cách (CSS #pmc-popup-body .pmc-detail-cell) và tăng số
    // cột/hàng (row-cols-5), không ẩn bớt field.
    var cells = new List<(string Label, string LabelKey, string Value, bool Wide)>
    {
        ("Dev", "", Val(Model.Dev), false),
        ("PO", "", Val(Model.PoNo), false),
        ("PO Date", "colPoDate", Fmt(Model.PoDate), false),
        ("ETD", "colEtd", Fmt(Model.Etd), false),
        ("Supplier", "", Val(Model.Supplier), false),
        ("Model", "", Val(Model.Model), false),
        ("Season", "", Val(Model.Season), false),
        ("Stage", "", Val(Model.Stage), false),
        ("Colorway", "", Val(Model.Colorway), false),
        ("Component", "", Val(Model.Component), false),
        ("Color code", "", Val(Model.ColorCode), false),
        ("Color name", "", Val(Model.ColorName), false),
        ("Size", "", Val(Model.SizeSpec), false),
        ("FOC", "", Val(Model.FocFlag), false),
        ("Original Price", "colOriginalPrice", Model.OriginalPrice?.ToString("N2") ?? "—", false),
        ("Payment Price", "colPaymentPrice", Model.PaymentPrice?.ToString("N2") ?? "—", false),
        ("Amount", "colAmount", Model.Amount?.ToString("N2") ?? "—", false),
        ("Ngày nhập", "detailArrivalDate", Fmt(Model.ArrivalDate), false),
        ("CS Code", "", Model.CsCode?.ToString() ?? "—", false),
        ("Test require", "", Val(Model.TestRequire), false),
        ("Test qty", "", Val(Model.TestQty), false),
        ("Category", "", Val(Model.Category), false),
        ("Request on", "", Fmt(Model.RequestOn), false),
        ("Mat'l Type", "", Val(Model.MatlType), false),
        ("PIC", "", Val(Model.Pic), false),
        ("Mat", "", Val(Model.Mat), false),
        ("Lên kệ lúc", "detailShelvedAt", Fmt(Model.StockedInAt), false),
        ("Xuất gần nhất", "detailLastIssued", Fmt(Model.LastIssuedAt), false),
        ("Hủy lúc", "detailDisposedAt", Fmt(Model.DisposedAt), false),
        ("Cập nhật gần nhất", "detailUpdatedAt", Model.UpdatedAt?.ToString("dd/MM/yyyy HH:mm") ?? "—", false),
        ("Mô tả liệu", "editMatlDescription", Val(Model.MatlDescription), true),
        ("Remark", "", Val(Model.Remark), true),
    };
}

<div class="row row-cols-5 g-1 small">
    <div class="pmc-detail-cell"><div class="text-muted" data-i18n="detailArrivalQty">Số lượng nhập</div><div class="fw-semibold">@Model.ArrivalQty @Model.Unit</div></div>
    <div class="pmc-detail-cell"><div class="text-muted" data-i18n="detailCurrentStock">Tồn hiện tại</div><div class="fw-semibold"><span class="badge" style="@balanceStyle font-weight:700;">@(Model.Balance?.ToString() ?? "—") @Model.Unit</span></div></div>
    <div class="pmc-detail-cell">
        <div class="text-muted">Testing</div>
        @if (Model.Testing.HasValue)
        {
            <div class="fw-semibold" data-i18n="@(Model.Testing == 1 ? "yesOption" : "noOption")">@(Model.Testing == 1 ? "Có" : "Không")</div>
        }
        else
        {
            <div class="fw-semibold">—</div>
        }
    </div>
    <div class="pmc-detail-cell"><div class="text-muted" data-i18n="overdue90Days">Quá hạn 90 ngày</div><div class="fw-semibold @(Model.IsOverdue ? "text-danger" : "")" data-i18n="@(Model.IsOverdue ? "yesOption" : "noOption")">@(Model.IsOverdue ? "Có" : "Không")</div></div>
    <div class="pmc-detail-cell"><div class="text-muted" data-i18n="detailCreatedAt">Ngày tạo</div><div class="fw-semibold">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div></div>
    @foreach (var c in cells)
    {
        <div class="@(c.Wide ? "col-12" : "") pmc-detail-cell">
            @if (string.IsNullOrEmpty(c.LabelKey))
            {
                <div class="text-muted">@c.Label</div>
            }
            else
            {
                <div class="text-muted" data-i18n="@c.LabelKey">@c.Label</div>
            }
            <div class="fw-semibold">@c.Value</div>
        </div>
    }
</div>

<hr class="my-2" />

<div class="d-flex align-items-center justify-content-between mb-2">
    <h6 class="mb-0"><span data-i18n="movementHistory">Lịch sử di chuyển</span> (@Model.Movements.Count)</h6>
    <div class="d-flex align-items-center gap-2">
        <span class="badge bg-dark-subtle text-dark-emphasis">
            <span data-i18n="currentStockLabel">Tồn kho hiện tại:</span> <span class="fw-semibold">@(Model.Balance?.ToString() ?? "—") @Model.Unit</span>
        </span>
        <button type="button" class="btn btn-sm btn-outline-secondary js-copy-history d-inline-flex align-items-center gap-1" title="Copy lịch sử để gửi chat" data-i18n-title="copyHistoryTooltip">
            <span class="material-icons" style="font-size:15px;">content_copy</span> <span data-i18n="btnCopy">Copy</span>
        </button>
    </div>
</div>
<div class="table-responsive" style="max-height: 240px; overflow-y: auto;">
    <table class="table table-sm align-middle small mb-0 pmc-excel-grid">
        <thead>
            <tr class="text-uppercase text-muted">
                <th data-i18n="colType">Loại</th>
                <th class="text-end" data-i18n="colQty">Số lượng</th>
                <th data-i18n="colShelf">Kệ</th>
                <th data-i18n="colPerformedBy">Người thực hiện</th>
                <th data-i18n="colIssuedTo">Giao cho</th>
                <th data-i18n="colTime">Thời gian</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var mv in Model.Movements)
            {
                <tr>
                    <td data-i18n="@("movement" + mv.MovementType)">@MovementLabel(mv.MovementType)</td>
                    <td class="text-end">@mv.Qty</td>
                    <td>@(mv.LocationCode ?? "—")</td>
                    <td>@(mv.Username ?? "—")</td>
                    <td>@(mv.RecipientName ?? "—")</td>
                    <td class="text-muted">@FmtDT(mv.OccurredAt)</td>
                </tr>
            }
            @if (Model.Movements.Count == 0)
            {
                <tr>
                    <td colspan="6" class="text-center text-muted py-3" data-i18n="noMovementHistory">Chưa có lịch sử di chuyển.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
