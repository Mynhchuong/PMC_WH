@using PmcWh.Web.Helpers
@model PmcWh.Web.Models.DisposeViewModel
@{
    ViewData["Title"] = "Hủy liệu";
    ViewData["TitleKey"] = "menuDispose";
}

<div class="card border-0 shadow-sm rounded-4 mb-2">
    <div class="card-body py-2">
        <div class="d-flex align-items-center gap-2 mb-2">
            <span class="d-inline-flex align-items-center justify-content-center rounded-3"
                  style="width:34px;height:34px;background:linear-gradient(135deg, #d63384 0%, #99245c 100%); flex-shrink:0;">
                <span class="material-icons text-white" style="font-size:18px;">delete_forever</span>
            </span>
            <div>
                <h6 class="card-title mb-0" data-i18n="menuDispose">Hủy liệu</h6>
                <p class="text-muted mb-0" style="font-size:0.7rem;" data-i18n="disposeSubtitle">Liệu hủy sẽ giữ lại 30 ngày rồi tự ẩn khỏi hệ thống</p>
            </div>
        </div>

        <label class="form-label small fw-semibold text-secondary mb-1" data-i18n="scanBarcodeLabel">Quét barcode</label>
        <div class="input-group input-group-sm mb-2" style="max-width: 420px;">
            <span class="input-group-text bg-white"><span class="material-icons" style="font-size:16px;">qr_code_scanner</span></span>
            <input type="text" id="scanInput" class="form-control" placeholder="Quét hoặc gõ barcode rồi Enter..." data-i18n-placeholder="scanBarcodePlaceholder" autofocus autocomplete="off" />
        </div>

        <form asp-controller="Dispose" asp-action="Index" method="get" class="d-flex flex-wrap align-items-end gap-2">
            @await Html.PartialAsync("_SearchConditions", (PmcWh.Web.Models.SearchFilterFields)Model)
            <div class="d-flex gap-1">
                <button type="submit" class="btn btn-sm btn-outline-dark d-inline-flex align-items-center gap-1">
                    <span class="material-icons" style="font-size:15px;">filter_alt</span> <span data-i18n="btnFilter">Lọc</span>
                </button>
                @if (Model.HasAnySearch)
                {
                    <a asp-controller="Dispose" asp-action="Index" class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1">
                        <span class="material-icons" style="font-size:15px;">filter_alt_off</span> <span data-i18n="btnClearFilter">Bỏ lọc</span>
                    </a>
                }
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
            <h5 class="card-title mb-0"><span data-i18n="disposableTitle">Có thể hủy</span> (@Model.Pagination.TotalCount)</h5>
            <button type="button" id="btnBulkDispose" class="btn btn-sm btn-outline-danger d-inline-flex align-items-center gap-1" disabled>
                <span class="material-icons" style="font-size:16px;">delete_sweep</span>
                <span data-i18n="btnBulkDispose">Hủy đã chọn</span>
                <span id="disposeBulkSelectedCount" class="badge bg-danger ms-1" style="display:none;"></span>
            </button>
        </div>
        <form asp-controller="Dispose" asp-action="BulkDispose" method="post" id="bulkDisposeForm"></form>

        <div class="table-responsive pmc-table-scroll">
            <table id="materialsTable" class="table align-middle table-sm pmc-table-compact" style="table-layout: fixed;">
                <colgroup>
                    <col data-col-key="select" style="width: 36px">
                    @{ await Html.RenderPartialAsync("_MaterialColGroup"); }
                    <col style="width: 100px">
                    <col style="width: 130px">
                    <col style="width: 110px">
                </colgroup>
                <thead>
                    <tr class="text-uppercase text-muted small" style="white-space: normal;">
                        <th>
                            <input type="checkbox" class="form-check-input" id="chkSelectAllDispose" title="Chọn tất cả" data-i18n-title="selectAllLabel" />
                        </th>
                        @{ await Html.RenderPartialAsync("_MaterialColHeaders"); }
                        <th class="text-end" data-i18n="colBalance">Tồn</th>
                        <th data-i18n="colStatus">Trạng thái</th>
                        <th class="text-end" data-i18n="colAction">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in Model.DisposableItems)
                    {
                        <tr class="js-disposable-row js-detail-row" data-material-id="@m.MaterialId" data-barcode="@m.Barcode" title="Double-click để xem chi tiết">
                            <td onclick="event.stopPropagation();">
                                <input type="checkbox" class="form-check-input js-dispose-check" value="@m.MaterialId" />
                            </td>
                            @{ await Html.RenderPartialAsync("_MaterialColCells", m); }
                            <td class="text-end">@m.Balance @m.Unit</td>
                            <td>
                                @{ var (badgeTextClass, badgeStyle) = MaterialStatusHelper.BadgeStyle(m.Status); }
                                <span class="badge @badgeTextClass" style="@badgeStyle" data-i18n="@("status" + m.Status)">@MaterialStatusHelper.Label(m.Status)</span>
                            </td>
                            <td class="text-end">
                                <form asp-controller="Dispose" asp-action="Scan" method="post" class="d-inline js-dispose-form">
                                    <input type="hidden" name="materialId" value="@m.MaterialId" />
                                    <input type="hidden" name="barcode" value="@m.Barcode" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger" data-i18n="btnDispose">Hủy</button>
                                </form>
                            </td>
                        </tr>
                    }
                    @if (Model.DisposableItems.Count == 0)
                    {
                        <tr>
                            <td colspan="22" class="text-center text-muted py-4" data-i18n="emptyDisposable">Không có liệu nào để hủy.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="mt-3">
            @await Html.PartialAsync("_Pagination", Model.Pagination)
        </div>
    </div>
</div>

<form asp-controller="Dispose" asp-action="Scan" method="post" id="disposeScanFallbackForm" class="d-none">
    <input type="hidden" name="materialId" id="disposeScanFallbackMaterialId" />
    <input type="hidden" name="barcode" id="disposeScanFallbackBarcode" />
</form>

<div id="pmc-flash"
     data-success="@(ViewData["FlashSuccess"] as string)"
     data-error="@(ViewData["FlashError"] as string)"
     style="display:none"></div>

@section Scripts {
    <script>
        (function () {
            var flash = document.getElementById('pmc-flash');
            if (flash.dataset.success) PmcUI.success(PmcWhI18n.renderFlash(flash.dataset.success));
            if (flash.dataset.error) PmcUI.error(PmcWhI18n.renderFlash(flash.dataset.error));

            // Bảng liệt kê liệu dùng chung cột với Materials/Index — cần init tooltip giống hệt cho
            // các ô bị cắt chữ (Supplier, Mat'l Description, Remark...) mới hiện được khi hover.
            document.querySelectorAll('#materialsTable [data-bs-toggle="tooltip"]').forEach(function (el) {
                if (el.getAttribute('title')) {
                    new bootstrap.Tooltip(el);
                }
            });

            document.querySelectorAll('.js-dispose-form').forEach(function (form) {
                form.addEventListener('submit', async function (e) {
                    e.preventDefault();
                    var barcode = form.querySelector('input[name="barcode"]').value;
                    var ok = await PmcUI.confirmDelete(PmcWhI18n.t('confirmDisposeMsg').replace('{barcode}', barcode));
                    if (ok) {
                        form.querySelector('button[type="submit"]').disabled = true;
                        form.submit();
                    }
                });
            });

            // Checkbox chọn nhiều dòng + nút "Hủy đã chọn" — cùng pattern với Materials/Index
            // (chkSelectAllMaterials / btnBulkDeleteMaterials), chỉ khác action là hủy chứ không xoá.
            (function () {
                var selectAll = document.getElementById('chkSelectAllDispose');
                var rowChecks = Array.prototype.slice.call(document.querySelectorAll('.js-dispose-check'));
                var bulkBtn = document.getElementById('btnBulkDispose');
                var bulkCountBadge = document.getElementById('disposeBulkSelectedCount');
                var bulkForm = document.getElementById('bulkDisposeForm');
                if (!bulkBtn || !bulkForm) return;

                function updateBulkUi() {
                    var checked = rowChecks.filter(function (c) { return c.checked; });
                    rowChecks.forEach(function (c) {
                        var row = c.closest('tr');
                        if (row) row.classList.toggle('pmc-row-selected', c.checked);
                    });
                    bulkBtn.disabled = checked.length === 0;
                    if (checked.length > 0) {
                        bulkCountBadge.textContent = PmcWhI18n.t('selectedCountLabel').replace('{0}', checked.length);
                        bulkCountBadge.style.display = '';
                    } else {
                        bulkCountBadge.style.display = 'none';
                    }
                    if (selectAll) {
                        selectAll.checked = rowChecks.length > 0 && checked.length === rowChecks.length;
                        selectAll.indeterminate = checked.length > 0 && checked.length < rowChecks.length;
                    }
                }

                if (selectAll) {
                    selectAll.addEventListener('change', function () {
                        rowChecks.forEach(function (c) { c.checked = selectAll.checked; });
                        updateBulkUi();
                    });
                }
                rowChecks.forEach(function (c) { c.addEventListener('change', updateBulkUi); });
                updateBulkUi();

                bulkBtn.addEventListener('click', async function () {
                    var checked = rowChecks.filter(function (c) { return c.checked; });
                    if (checked.length === 0) return;
                    var ok = await PmcUI.confirmDelete(PmcWhI18n.t('confirmBulkDisposeMsg').replace('{0}', checked.length));
                    if (!ok) return;
                    bulkForm.querySelectorAll('input[name="materialIds"], input[name="returnUrl"]').forEach(function (el) { el.remove(); });
                    checked.forEach(function (c) {
                        var input = document.createElement('input');
                        input.type = 'hidden';
                        input.name = 'materialIds';
                        input.value = c.value;
                        bulkForm.appendChild(input);
                    });
                    var returnUrlInput = document.createElement('input');
                    returnUrlInput.type = 'hidden';
                    returnUrlInput.name = 'returnUrl';
                    returnUrlInput.value = window.location.pathname + window.location.search;
                    bulkForm.appendChild(returnUrlInput);
                    bulkBtn.disabled = true;
                    bulkForm.submit();
                });
            })();

            var scanInput = document.getElementById('scanInput');
            scanInput.addEventListener('keydown', async function (e) {
                if (e.key !== 'Enter') return;
                e.preventDefault();
                var code = scanInput.value.trim();
                scanInput.value = '';
                if (!code) return;

                var row = document.querySelector('.js-disposable-row[data-barcode="' + CSS.escape(code) + '"]');
                if (row) {
                    row.querySelector('.js-dispose-form').requestSubmit();
                    return;
                }

                // Danh sách đã phân trang — liệu quét trúng có thể đang nằm ở trang khác, không có
                // sẵn trong DOM. Tra trực tiếp qua Api thay vì chỉ tìm trong trang hiện tại.
                try {
                    var res = await PmcUI.withLoading(() => fetch('Materials/ByBarcode/' + encodeURIComponent(code)));
                    if (!res.ok) {
                        PmcUI.error(PmcWhI18n.t('notFoundDisposable').replace('{code}', code));
                        return;
                    }
                    var item = await res.json();
                    if (item.status === 'Disposed') {
                        PmcUI.error(PmcWhI18n.t('notFoundDisposable').replace('{code}', code));
                        return;
                    }
                    var ok = await PmcUI.confirmDelete(PmcWhI18n.t('confirmDisposeMsg').replace('{barcode}', item.barcode));
                    if (!ok) return;
                    document.getElementById('disposeScanFallbackMaterialId').value = item.materialId;
                    document.getElementById('disposeScanFallbackBarcode').value = item.barcode;
                    document.getElementById('disposeScanFallbackForm').requestSubmit();
                } catch (err) {
                    PmcUI.error(PmcWhI18n.t('networkError'));
                }
            });

            // Draggable column resize — đồng bộ với Materials/Index, dùng chung 1 localStorage key
            // nên độ rộng cột kéo ở trang nào cũng áp dụng cho các trang liệt kê liệu khác.
            (function () {
                var STORAGE_KEY = 'pmc_materials_col_widths_v1';
                var table = document.getElementById('materialsTable');
                if (!table) return;

                function colFor(key) {
                    return table.querySelector('col[data-col-key="' + key + '"]');
                }

                var saved = {};
                try { saved = JSON.parse(localStorage.getItem(STORAGE_KEY)) || {}; } catch (e) { saved = {}; }
                Object.keys(saved).forEach(function (key) {
                    var col = colFor(key);
                    if (col && saved[key] > 0) col.style.width = saved[key] + 'px';
                });

                function saveWidths() {
                    var widths = {};
                    table.querySelectorAll('col[data-col-key]').forEach(function (col) {
                        widths[col.dataset.colKey] = col.getBoundingClientRect().width;
                    });
                    localStorage.setItem(STORAGE_KEY, JSON.stringify(widths));
                }

                table.querySelectorAll('.col-resizer').forEach(function (resizer) {
                    resizer.addEventListener('mousedown', function (e) {
                        e.preventDefault();
                        var col = colFor(resizer.dataset.colKey);
                        if (!col) return;
                        var startX = e.clientX;
                        var startWidth = col.getBoundingClientRect().width;
                        resizer.classList.add('is-resizing');
                        document.body.classList.add('pmc-col-resizing');

                        function onMove(ev) {
                            var newWidth = Math.max(40, startWidth + (ev.clientX - startX));
                            col.style.width = newWidth + 'px';
                        }
                        function onUp() {
                            document.removeEventListener('mousemove', onMove);
                            document.removeEventListener('mouseup', onUp);
                            resizer.classList.remove('is-resizing');
                            document.body.classList.remove('pmc-col-resizing');
                            saveWidths();
                        }
                        document.addEventListener('mousemove', onMove);
                        document.addEventListener('mouseup', onUp);
                    });
                });
            })();
        })();
    </script>
}
