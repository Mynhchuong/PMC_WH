@using System.Text.Json
@model PmcWh.Web.Models.ReturnViewModel
@{
    ViewData["Title"] = "Nhận lại hàng";
    var locationsJson = JsonSerializer.Serialize(Model.Locations, new JsonSerializerOptions(JsonSerializerDefaults.Web));
}

<div class="card border-0 shadow-sm rounded-4 mb-3">
    <div class="card-body">
        <div class="d-flex align-items-center gap-3 mb-4">
            <span class="d-inline-flex align-items-center justify-content-center rounded-4"
                  style="width:48px;height:48px;background:linear-gradient(135deg, #495057 0%, #212529 100%); flex-shrink:0;">
                <span class="material-icons text-white">assignment_return</span>
            </span>
            <div>
                <h5 class="card-title mb-0">Nhận lại hàng</h5>
                <p class="text-muted small mb-0">Hàng đã xuất quay về kho — cộng lại tồn, về kệ</p>
            </div>
        </div>

        <label class="form-label small fw-semibold text-secondary">Quét barcode</label>
        <div class="input-group" style="max-width: 420px;">
            <span class="input-group-text bg-white"><span class="material-icons" style="font-size:18px;">qr_code_scanner</span></span>
            <input type="text" id="scanInput" class="form-control" placeholder="Quét hoặc gõ barcode rồi Enter..." autofocus autocomplete="off" />
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body">
        <h5 class="card-title mb-3">Đang out, có thể nhận lại (@Model.ReturnableItems.Count)</h5>

        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr class="text-uppercase text-muted small">
                        <th>Barcode</th>
                        <th>Dev</th>
                        <th>Model</th>
                        <th>Colorway</th>
                        <th>Size</th>
                        <th class="text-end">Đã xuất còn thiếu</th>
                        <th class="text-end">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in Model.ReturnableItems)
                    {
                        var outstanding = (m.ArrivalQty ?? 0) - (m.Balance ?? 0);
                        <tr class="js-returnable-row" data-barcode="@m.Barcode">
                            <td class="fw-semibold">@m.Barcode</td>
                            <td>@m.Dev</td>
                            <td>@m.Model</td>
                            <td>@m.Colorway</td>
                            <td>@m.SizeSpec</td>
                            <td class="text-end">@outstanding @m.Unit</td>
                            <td class="text-end">
                                <button type="button" class="btn btn-sm pmc-btn-dark js-open-return"
                                        data-material-id="@m.MaterialId" data-barcode="@m.Barcode"
                                        data-outstanding="@outstanding" data-unit="@m.Unit">
                                    Nhận lại
                                </button>
                            </td>
                        </tr>
                    }
                    @if (Model.ReturnableItems.Count == 0)
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">Không có liệu nào đang out.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="returnModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 shadow">
            <div class="modal-header border-0">
                <h5 class="modal-title">Nhận lại — <span id="returnBarcodeLabel"></span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="Return" asp-action="Scan" method="post">
                <input type="hidden" name="materialId" id="returnMaterialId" />
                <input type="hidden" name="barcode" id="returnBarcode" />
                <div class="modal-body">
                    <p class="text-muted small mb-3">Đã xuất còn thiếu: <span id="returnOutstandingLabel" class="fw-semibold"></span></p>

                    <label class="form-label small fw-semibold text-secondary">Số lượng nhận lại</label>
                    <input type="number" name="qty" id="returnQty" class="form-control mb-3" step="0.01" min="0.01" required />

                    <label class="form-label small fw-semibold text-secondary">Kệ</label>
                    <select id="rackSelect" class="form-select mb-2"></select>

                    <label class="form-label small fw-semibold text-secondary">Tầng</label>
                    <select name="locationId" id="levelSelect" class="form-select" required></select>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn pmc-btn-dark d-inline-flex align-items-center gap-1">
                        <span class="material-icons" style="font-size:18px;">check</span> Xác nhận
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<div id="pmc-flash"
     data-success="@(ViewData["FlashSuccess"] as string)"
     data-error="@(ViewData["FlashError"] as string)"
     style="display:none"></div>

@section Scripts {
    <script>
        (function () {
            var flash = document.getElementById('pmc-flash');
            if (flash.dataset.success) PmcUI.success(flash.dataset.success);
            if (flash.dataset.error) PmcUI.error(flash.dataset.error);

            var locations = @Html.Raw(locationsJson);
            var byRack = {};
            locations.forEach(function (loc) {
                (byRack[loc.rackNo] = byRack[loc.rackNo] || []).push(loc);
            });
            var racks = Object.keys(byRack).map(Number).sort(function (a, b) { return a - b; });

            var rackSelect = document.getElementById('rackSelect');
            var levelSelect = document.getElementById('levelSelect');

            racks.forEach(function (rack) {
                var opt = document.createElement('option');
                opt.value = rack;
                opt.textContent = 'Kệ ' + rack;
                rackSelect.appendChild(opt);
            });

            function populateLevels(rack) {
                levelSelect.innerHTML = '';
                (byRack[rack] || []).sort(function (a, b) { return a.levelNo - b.levelNo; }).forEach(function (loc) {
                    var opt = document.createElement('option');
                    opt.value = loc.locationId;
                    opt.textContent = 'Tầng ' + loc.levelNo + ' (' + loc.code + ')';
                    levelSelect.appendChild(opt);
                });
            }

            rackSelect.addEventListener('change', function () { populateLevels(rackSelect.value); });
            if (racks.length > 0) {
                rackSelect.value = racks[0];
                populateLevels(racks[0]);
            }

            var returnModal = new bootstrap.Modal(document.getElementById('returnModal'));

            function openReturnFor(materialId, barcode, outstanding, unit) {
                document.getElementById('returnMaterialId').value = materialId;
                document.getElementById('returnBarcode').value = barcode;
                document.getElementById('returnBarcodeLabel').textContent = barcode;
                document.getElementById('returnOutstandingLabel').textContent = outstanding + ' ' + (unit || '');
                var qtyInput = document.getElementById('returnQty');
                qtyInput.value = outstanding;
                qtyInput.max = outstanding;
                returnModal.show();
            }

            document.querySelectorAll('.js-open-return').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    openReturnFor(btn.dataset.materialId, btn.dataset.barcode, btn.dataset.outstanding, btn.dataset.unit);
                });
            });

            var scanInput = document.getElementById('scanInput');
            scanInput.addEventListener('keydown', function (e) {
                if (e.key !== 'Enter') return;
                e.preventDefault();
                var code = scanInput.value.trim();
                scanInput.value = '';
                if (!code) return;

                var row = document.querySelector('.js-returnable-row[data-barcode="' + CSS.escape(code) + '"]');
                if (!row) {
                    PmcUI.error('Không tìm thấy barcode "' + code + '" trong danh sách đang out.');
                    return;
                }
                var btn = row.querySelector('.js-open-return');
                openReturnFor(btn.dataset.materialId, btn.dataset.barcode, btn.dataset.outstanding, btn.dataset.unit);
            });
        })();
    </script>
}
